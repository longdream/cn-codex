[Unit]
Description=CN-Codex Update Server (Python)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/cn-codex-update
Environment=BIND=0.0.0.0:5005
Environment=PUBLIC_DIR=/opt/cn-codex-update/public
# Optional override, e.g. Environment=PYTHON_BIN=/root/miniconda3/bin/python
ExecStart=/opt/cn-codex-update/run.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
