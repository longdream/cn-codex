{
  "$schema": "https://raw.githubusercontent.com/nicegram/nicegram-tauri/main/crates/tauri-config-schema/schema.json",
  "productName": "CN-Codex",
  "identifier": "com.cn-codex.app",
  "build": {
    "beforeDevCommand": "node scripts/run-package-bin.mjs vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/run-package-bin.mjs typescript:tsc --noEmit && node scripts/run-package-bin.mjs vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CN-Codex",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "visible": false,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/ocr/README.md",
      "resources/ocr/onnxruntime.dll",
      "resources/ocr/onnxruntime_providers_shared.dll",
      "resources/ocr/ppocrv5_mobile_det.onnx",
      "resources/ocr/ppocrv5_mobile_rec.onnx",
      "resources/ocr/ppocrv5_mobile_vocab.txt"
    ]
  }
}
