核心逻辑 (main.js)

const WS_URL = "ws://127.0.0.1:23300/wps";
let ws = null;

function onLoad() {
  connectToCodex();
  wps.ApiEvent.AddApiEventListener("DocumentOpen", onDocumentOpen);
  wps.ApiEvent.AddApiEventListener("DocumentBeforeSave", onDocumentSave);
}

function connectToCodex() {
  ws = new WebSocket(WS_URL);
  ws.onopen = () => { /* 发送握手, 报告当前文档状态 */ };
  ws.onmessage = (e) => { handleCommand(JSON.parse(e.data)); };
  ws.onclose = () => { setTimeout(connectToCodex, 3000); }; // 自动重连
}

function handleCommand(msg) {
  const handler = commandHandlers[msg.method];
  if (handler) {
    const result = handler(msg.params);
    ws.send(JSON.stringify({ id: msg.id, result }));
  } else {
    ws.send(JSON.stringify({ id: msg.id, error: { message: "Unknown method" } }));
  }
}

