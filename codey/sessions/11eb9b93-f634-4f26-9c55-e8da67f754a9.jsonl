{"type":"message","id":"3a4b1a96-9a0a-43c6-9434-e5afaaad9090","role":"tool","content":"import PptxGenJS from 'pptxgenjs';\nimport { deckData } from './content.mjs';\n\nconst pptx = new PptxGenJS();\npptx.layout = 'LAYOUT_WIDE';\npptx.author = 'OpenAI Codex';\npptx.company = 'OpenAI';\npptx.subject = '软通动力公司介绍';\npptx.title = deckData.title;\npptx.lang = 'zh-CN';\npptx.theme = { headFontFace: 'Microsoft YaHei', bodyFontFace: 'Microsoft YaHei', lang: 'zh-CN' };\n\npptx.defineSlideMaster({\n  title: 'MASTER',\n  background: { color: 'FFFFFF' },\n  objects: [\n    { rect: { x: 0, y: 0, w: 13.333, h: 0.2, fill: { color: '0F2747' }, line: { color: '0F2747', pt: 0 } } },\n    { line: { x: 0.75, y: 6.95, w: 11.8, h: 0, line: { color: 'D7E3F4', pt: 1 } } },\n    { text: { text: deckData.title, options: { x: 0.78, y: 7.0, w: 3.4, h: 0.2, fontFace: 'Microsoft YaHei', fontSize: 8.5, color: '6B7785' } } }\n  ]\n});\n\nfunction addTitle(slide, title, subtitle) {\n  slide.addText(title, { x: 0.75, y: 0.45, w: 8, h: 0.5, fontFace: 'Microsoft YaHei', fontSize: 26, bold: true, color: '0F2747', margin: 0 });\n  if (subtitle) slide.addText(subtitle, { x: 0.78, y: 1.02, w: 9.5, h: 0.28, fontFace: 'Microsoft YaHei', fontSize: 11.5, color: '6B7785', margin: 0 });\n  slide.addShape(pptx.ShapeType.line, { x: 0.75, y: 1.42, w: 11.7, h: 0, line: { color: '1F5FBF', pt: 1.25 } });\n}\n\nfunction bulletList(slide, items, x, y, w, h, fontSize = 15.5) {\n  const runs = [];\n  items.forEach((item, idx) => {\n    runs.push({ text: item, options: { bullet: { indent: 14 } } });\n    if (idx < items.length - 1) runs.push({ text: '\\n' });\n  });\n  slide.addText(runs, { x, y, w, h, fontFace: 'Microsoft YaHei', fontSize, color: '22303C', breakLine: false, paraSpaceAfterPt: 8, valign: 'top', margin: 0.03 });\n}\n\nfunction card(slide, { x, y, w, h, title, text, accent = '1F5FBF', fill = 'FFFFFF' }) {\n  slide.addShape(pptx.ShapeType.roundRect, { x, y, w, h, rectRadius: 0.06, fill: { color: fill }, line: { color: 'D7E3F4', pt: 1 } });\n  slide.addShape(pptx.ShapeType.rect, { x, y, w, h: 0.1, fill: { color: accent }, line: { color: accent, pt: 0 } });\n  slide.addText(title, { x: x + 0.18, y: y + 0.18, w: w - 0.36, h: 0.28, fontFace: 'Microsoft YaHei', fontSize: 15.5, bold: true, color: '0F2747', margin: 0 });\n  slide.addText(text, { x: x + 0.18, y: y + 0.54, w: w - 0.36, h: h - 0.7, fontFace: 'Microsoft YaHei', fontSize: 11.5, color: '22303C', valign: 'top', margin: 0.02 });\n}\n\nfunction addPageNum(slide, idx) {\n  slide.addText(idx.toString(), { x: 12.2, y: 7.0, w: 0.6, h: 0.2, fontFace: 'Microsoft YaHei', fontSize: 8, color: 'B0C4DE', align: 'right', margin: 0 });\n}\n\nconst cover = pptx.addSlide();\ncover.background = { color: 'F4F7FB' };\ncover.addShape(pptx.ShapeType.rect, { x: 0, y: 0, w: 4.05, h: 7.5, fill: { color: '0F2747' }, line: { color: '0F2747', pt: 0 } });\ncover.addText('软通动力', { x: 0.72, y: 1.1, w: 2.6, h: 0.5, fontFace: 'Microsoft YaHei', fontSize: 28, bold: true, color: 'FFFFFF', margin: 0 });\ncover.addText('公司介绍', { x: 0.72, y: 1.75, w: 2.6, h: 0.45, fontFace: 'Microsoft YaHei', fontSize: 22, bold: true, color: 'FFFFFF', margin: 0 });\ncover.addText(deckData.subtitle, { x: 0.72, y: 2.5, w: 2.7, h: 0.75, fontFace: 'Microsoft YaHei', fontSize: 13.5, color: 'D8E7FF', margin: 0 });\ncover.addShape(pptx.ShapeType.roundRect, { x: 4.5, y: 0.9, w: 8.0, h: 5.6, rectRadius: 0.06, fill: { color: 'FFFFFF' }, line: { color: 'D7E3F4', pt: 1 } });\ncover.addText('核心摘要', { x: 4.95, y: 1.2, w: 2.5, h: 0.35, fontFace: 'Microsoft YaHei', fontSize: 20, bold: true, color: '0F2747', margin: 0 });\nbulletList(cover, deckData.summary, 4.9, 1.75, 6.7, 2.8, 15.5);\ncover.addShape(pptx.ShapeType.line, { x: 4.95, y: 5.0, w: 6.5, h: 0, line: { color: 'D7E3F4', pt: 1 } });\ncover.addText('关键词：数字化转型 ｜ AI 与大模型 ｜ 云与数据 ｜ 行业解决方案', { x: 4.95, y: 5.2, w: 6.6, h: 0.22, fontFace: 'Microsoft YaHei', fontSize: 11.5, color: '1F5FBF', margin: 0 });\ncover.addText('股票代码：301236', { x: 0.72, y: 6.5, w: 2.5, h: 0.26, fontFace: 'Microsoft YaHei', fontSize: 11, color: 'D8E7FF', margin: 0 });\naddPageNum(cover, 1);\n\n// page\nconst toc = pptx.addSlide();\ntoc.background = { color: 'F4F7FB' };\ntoc.addShape(pptx.ShapeType.rect, { x: 0, y: 0, w: 4.05, h: 7.5, fill: { color: '0F2747' }, line: { color: '0F2747', pt: 0 } });\ntoc.addText('目录', { x: 0.72, y: 1.0, w: 2.5, h: 0.48, fontFace: 'Microsoft YaHei', fontSize: 26, bold: true, color: 'FFFFFF', margin: 0 });\ntoc.addText('CONTENTS', { x: 0.72, y: 1.62, w: 2.5, h: 0.22, fontFace: 'Microsoft YaHei', fontSize: 12, color: 'D8E7FF', margin: 0 });\ntoc.addShape(pptx.ShapeType.rect, { x: 0.72, y: 2.2, w: 2.0, h: 0.04, fill: { color: '4DB6E5' }, line: { color: '4DB6E5', pt: 1 } });\nconst leftItems = deckData.tocItems.slice(0, 5);\nconst rightItems = deckData.tocItems.slice(5);\n[leftItems, rightItems].forEach((items, col) => {\n  const colX = col === 0 ? 4.8 : 8.2;\n  items.forEach((item, idx) => {\n    const globalIdx = col * 5 + idx;\n    const y = 1.1 + idx * 1.1;\n    toc.addShape(pptx.ShapeType.ellipse, { x: colX, y: y + 0.05, w: 0.32, h: 0.32, fill: { color: '1F5FBF' }, line: { color: '1F5FBF', pt: 1 } });\n    toc.addText((globalIdx + 1).toString(), { x: colX + 0.03, y: y + 0.04, w: 0.26, h: 0.28, fontFace: 'Microsoft YaHei', fontSize: 14, bold: true, color: 'FFFFFF', align: 'center', valign: 'mid', margin: 0 });\n    toc.addText(item, { x: colX + 0.52, y, w: 3.2, h: 0.38, fontFace: 'Microsoft YaHei', fontSize: 15.5, color: '22303C', margin: 0 });\n  });\n});\naddPageNum(toc, 2);\n\n/* ----- regular content ----- */\nconst slideDefs = [\n  { title: '公司概况', subtitle: '从软件与数字技术服务出发，持续向全栈智能升级', bg: 'FFFFFF',\n    cards: [\n      { x:0.82, y:1.86, w:3.72, h:1.62, title:'企业定位', text:deckData.highlights[0].text },\n      { x:4.8, y:1.86, w:3.72, h:1.62, title:'资本市场', text:deckData.highlights[1].text },\n      { x:8.78, y:1.86, w:3.72, h:1.62, title:'布局能力', text:deckData.highlights[2].text }\n    ],\n    bullets: ['官网将软通动力定位为\"企业数字化转型可信赖合作伙伴\"。','公司提供软件与数字技术服务，并延展至软硬协同、智能化与行业解决方案。','面向大型政企客户，强调长期交付、行业理解与生态协同能力。']\n  },\n  { title: '业务版图', subtitle: '覆盖咨询、技术服务、运营服务的完整链条', bg: 'FFFFFF',\n    cards: [\n      { x:0.82, y:1.84, w:5.75, h:1.56, title:'四大服务方向', text:deckData.business.join('\\n') },\n      { x:6.75, y:1.84, w:5.75, h:1.56, title:'能力延展', text:'从项目实施逐步延展到平台、数据、AI、国产化和运营等高附加值领域。' }\n    ],\n    bullets: ['咨询与解决方案帮助客户完成顶层设计与业务场景梳理。','数字技术服务承接云、数据、AI、工业互联网等关键技术落地。','通用技术与运营服务为大规模持续交付提供基础支撑。']\n  },\n  { title: '行业覆盖', subtitle: '多行业服务能力构成公司增长与复用基础', bg: 'F7FAFC',\n    cards: [\n      { x:0.82, y:1.88, w:5.72, h:4.15, title:'重点行业', text:deckData.industries.join('\\n'), fill:'FFFFFF' },\n      { x:6.8, y:1.88, w:5.72, h:4.15, title:'行业价值', text:'软通动力的行业布局有助于形成\"通用能力 + 场景方案\"的双轮驱动。\\n\\n一方面通过通用技术平台提升交付效率；另一方面通过金融、制造、能源、零售等场景沉淀行业经验，提高方案复用与客户黏性。', fill:'FFFFFF' }\n    ]\n  },\n  { title: '核心能力', subtitle: '围绕智能化、云数据与自主创新构建竞争力', bg: 'FFFFFF',\n    cards: [\n      { x:0.8, y:1.92, w:2.85, h:4.05, title:'AI 与大模型', text:deckData.capabilities[0] },\n      { x:3.83, y:1.92, w:2.85, h:4.05, title:'云与数据', text:deckData.capabilities[1] },\n      { x:6.86, y:1.92, w:2.85, h:4.05, title:'信创生态', text:deckData.capabilities[2] },\n      { x:9.89, y:1.92, w:2.85, h:4.05, title:'行业方案', text:deckData.capabilities[3] }\n    ]\n  },\n  { title: '应用场景', subtitle: '以行业方案推动数字化项目落地', bg: 'FFFFFF',\n    cards: [\n      { x:6.7, y:1.95, w:5.6, h:3.95, title:'场景化方法论', text:'软通动力的价值不只是提供单点技术，而是将咨询、平台、开发、运维与行业经验打包为可落地的解决方案。\\n\\n这类能力适合大型客户在复杂系统、多组织协同、长期运营场景中的持续转型需求。' }\n    ],\n    bullets: deckData.cases,\n    bulletX: 0.9, bulletY: 1.95, bulletW: 5.45, bulletH: 3.95\n  }\n];\n\nslideDefs.forEach((def, idx) => {\n  const slide = pptx.addSlide('MASTER');\n  slide.background = { color: def.bg };\n  addTitle(slide, def.title, def.subtitle);\n  if (def.cards) def.cards.forEach(c => card(slide, c));\n  const bX = def.bulletX ?? 0.88;\n  const bY = def.bulletY ?? (def.cards?.length > 0 ? 4.0 : 2.0);\n  const bW = def.bulletW ?? 11.2;\n  const bH = def.bulletH ?? 2.15;\n  if (def.bullets) bulletList(slide, def.bullets, bX, bY, bW, bH);\n  addPageNum(slide, 3 + idx);\n});\n\n/* ----- development path (special layout) ----- */\nconst devPath = pptx.addSlide('MASTER');\ndevPath.background = { color: 'F7FAFC' };\naddTitle(devPath, '发展路径', '从软件服务积累走向全栈智能与生态协同');\nconst lineY = 3.45;\ndevPath.addShape(pptx.ShapeType.line, { x: 1.1, y: lineY, w: 10.95, h: 0, line: { color: '9BB8E8', pt: 2.2 } });\nconst tX = [1.1, 3.95, 6.8, 9.65];\ndeckData.timeline.forEach((item, idx) => {\n  const x = tX[idx];\n  devPath.addShape(pptx.ShapeType.ellipse, { x, y: 3.18, w: 0.56, h: 0.56, fill: { color: '1F5FBF' }, line: { color: '1F5FBF', pt: 1 } });\n  devPath.addText(item.period, { x: x - 0.25, y: 2.52, w: 1.2, h: 0.28, fontFace: 'Microsoft YaHei', fontSize: 13, bold: true, color: '0F2747', align: 'center', margin: 0 });\n  card(devPath, { x: x - 0.42, y: 3.95, w: 2.15, h: 1.55, title: `阶段 ${idx + 1}`, text: item.text, fill: 'FFFFFF' });\n});\naddPageNum(devPath, 8);\n\n/* ----- cooperation value (two-column layout) ----- */\nconst collab = pptx.addSlide('MASTER');\ncollab.background = { color: 'FFFFFF' };\naddTitle(collab, '合作价值', '软通动力适合与怎样需求的客户合作');\nconst leftText = deckData.collaboration.slice(0, 2);\nconst rightText = deckData.collaboration.slice(2);\n[leftText, rightText].forEach((items, col) => {\n  const cx = col === 0 ? 0.82 : 6.82;\n  items.forEach((item, idx) => {\n    const cy = 1.85 + idx * 2.28;\n    card(collab, { x: cx, y: cy, w: 5.65, h: 2.0, title: item.area, text: item.description });\n  });\n});\naddPageNum(collab, 9);\n\n/* ----- outlook ----- */\nconst outlook = pptx.addSlide('MASTER');\noutlook.background = { color: 'F7FAFC' };\naddTitle(outlook, '发展展望', '从软件服务走向全栈智能、国产化与生态协同');\ncard(outlook, { x: 0.9, y: 2.0, w: 3.72, h: 3.78, title: '战略方向一', text: deckData.outlook[0] });\ncard(outlook, { x: 4.82, y: 2.0, w: 3.72, h: 3.78, title: '战略方向二', text: deckData.outlook[1] });\ncard(outlook, { x: 8.74, y: 2.0, w: 3.72, h: 3.78, title: '战略方向三', text: deckData.outlook[2] });\naddPageNum(outlook, 10);\n\n/* ----- core values ----- */\nconst values = pptx.addSlide('MASTER');\nvalues.background = { color: 'FFFFFF' };\naddTitle(values, '核心价值总结', '适合需要复杂数字化转型与长期运营能力的政企客户');\ncard(values, { x: 0.85, y: 1.95, w: 2.82, h: 3.95, title: '懂业务', text: deckData.valuePoints[0], fill: 'FFFFFF' });\ncard(values, { x: 3.85, y: 1.95, w: 2.82, h: 3.95, title: '能交付', text: deckData.valuePoints[1], fill: 'FFFFFF' });\ncard(values, { x: 6.85, y: 1.95, w: 2.82, h: 3.95, title: '可升级', text: deckData.valuePoints[2], fill: 'FFFFFF' });\ncard(values, { x: 9.85, y: 1.95, w: 2.82, h: 3.95, title: '重生态', text: deckData.valuePoints[3], fill: 'FFFFFF' });\naddPageNum(values, 11);\n\n/* ----- closing ----- */\nconst closing = pptx.addSlide('MASTER');\naddTitle(closing, '结语', '软通动力的核心价值在于长期服务大型客户的综合数字化能力');\nclosing.addShape(pptx.ShapeType.roundRect, { x: 0.95, y: 1.95, w: 11.35, h: 2.85, rectRadius: 0.06, fill: { color: 'EAF2FF' }, line: { color: 'D7E3F4', pt: 1 } });\nclosing.addText('作为一家以软件与数字技术服务为基础、向全栈智能持续升级的上市公司，软通动力在多行业、多技术栈和多类型交付场景中形成了较强的综合服务能力。对于需要推进数字化、智能化、自主化升级的政企客户而言，其价值体现在：既能理解业务，又能组织复杂技术落地。', { x: 1.3, y: 2.35, w: 10.55, h: 1.7, fontFace: 'Microsoft YaHei', fontSize: 18, color: '22303C', margin: 0.04, valign: 'mid' });\nclosing.addText(deckData.references.join('\\n'), { x: 0.98, y: 5.45, w: 11.2, h: 0.6, fontFace: 'Microsoft YaHei', fontSize: 10.5, color: '6B7785', margin: 0 });\naddPageNum(closing, 12);\n\nawait pptx.writeFile({ fileName: '软通动力公司介绍.pptx' });\nconsole.log('Generated final deck: 软通动力公司介绍.pptx');","timestamp":1781345261,"tool_call_id":"call_153371d00b8f4f3d91ebb23d","tool_name":"read_file","tool_calls":null}
