{"type":"message","id":"cb6c729e-76ec-4f66-a6f0-d246d25afe94","role":"tool","content":"import { defineConfig } from 'vite';\nimport react from '@vitejs/plugin-react';\nimport path from 'path';\n\nexport default defineConfig({\n  plugins: [react()],\n  resolve: {\n    alias: {\n      '@': path.resolve(__dirname, './src'),\n    },\n  },\n  server: {\n    port: 5173,\n    proxy: {\n      '/api': {\n        target: 'http://localhost:5000',\n        changeOrigin: true,\n      },\n    },\n  },\n});","timestamp":1781396210,"tool_call_id":"call_330d1261a6844f59be6bc971","tool_name":"read_file","tool_calls":null}
{"type":"message","id":"8b0af21d-9ff5-4d4f-9e38-8e39a29060c6","role":"tool","content":"import axios, { AxiosInstance, AxiosError, InternalAxiosRequestConfig } from 'axios';\nimport type {\n  ApiResponse,\n  PaginatedResponse,\n  LoginRequest,\n  RegisterRequest,\n  User,\n  Product,\n  CartItem,\n  Order,\n  AddCartRequest,\n  CreateOrderRequest,\n} from '../types';\n\n/** 创建 Axios 实例 */\nconst api: AxiosInstance = axios.create({\n  baseURL: '/api',\n  timeout: 15000,\n  headers: {\n    'Content-Type': 'application/json',\n  },\n});\n\n/** 请求拦截器 - 自动添加 Token */\napi.interceptors.request.use(\n  (config: InternalAxiosRequestConfig) => {\n    const token = localStorage.getItem('token');\n    if (token && config.headers) {\n      config.headers.Authorization = `Bearer ${token}`;\n    }\n    return config;\n  },\n  (error: AxiosError) => Promise.reject(error)\n);\n\n/** 响应拦截器 - 统一错误处理 */\napi.interceptors.response.use(\n  (response) => response,\n  (error: AxiosError<ApiResponse>) => {\n    if (error.response?.status === 401) {\n      localStorage.removeItem('token');\n      localStorage.removeItem('user');\n      // 如果在非登录页面，重定向到登录\n      if (window.location.pathname !== '/login') {\n        window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);\n      }\n    }\n    return Promise.reject(error);\n  }\n);\n\n// =========== 认证 API ===========\n\nexport const authApi = {\n  /** 登录 */\n  login: async (data: LoginRequest): Promise<ApiResponse<{ token: string; user: User }>> => {\n    const res = await api.post('/auth/login', data);\n    return res.data;\n  },\n\n  /** 注册 */\n  register: async (data: RegisterRequest): Promise<ApiResponse<{ token: string; user: User }>> => {\n    const res = await api.post('/auth/register', data);\n    return res.data;\n  },\n\n  /** 获取用户信息 */\n  getProfile: async (): Promise<ApiResponse<User>> => {\n    const res = await api.get('/auth/profile');\n    return res.data;\n  },\n\n  /** 更新用户信息 */\n  updateProfile: async (data: Partial<User>): Promise<ApiResponse<User>> => {\n    const res = await api.put('/auth/profile', data);\n    return res.data;\n  },\n};\n\n// =========== 商品 API ===========\n\nexport const productApi = {\n  /** 获取商品列表 */\n  getProducts: async (params?: {\n    page?: number;\n    limit?: number;\n    category?: string;\n    search?: string;\n    sort?: string;\n    minPrice?: number;\n    maxPrice?: number;\n  }): Promise<PaginatedResponse<Product>> => {\n    const res = await api.get('/products', { params });\n    return res.data;\n  },\n\n  /** 获取商品详情 */\n  getProductById: async (id: string): Promise<ApiResponse<Product>> => {\n    const res = await api.get(`/products/${id}`);\n    return res.data;\n  },\n\n  /** 获取分类列表 */\n  getCategories: async (): Promise<ApiResponse<string[]>> => {\n    const res = await api.get('/products/categories');\n    return res.data;\n  },\n\n  /** 创建商品（管理员） */\n  createProduct: async (data: Partial<Product>): Promise<ApiResponse<Product>> => {\n    const res = await api.post('/products', data);\n    return res.data;\n  },\n\n  /** 更新商品（管理员） */\n  updateProduct: async (id: string, data: Partial<Product>): Promise<ApiResponse<Product>> => {\n    const res = await api.put(`/products/${id}`, data);\n    return res.data;\n  },\n\n  /** 删除商品（管理员） */\n  deleteProduct: async (id: string): Promise<ApiResponse<null>> => {\n    const res = await api.delete(`/products/${id}`);\n    return res.data;\n  },\n};\n\n// =========== 购物车 API ===========\n\nexport const cartApi = {\n  /** 获取购物车 */\n  getCart: async (): Promise<ApiResponse<CartItem[]>> => {\n    const res = await api.get('/cart');\n    return res.data;\n  },\n\n  /** 添加商品到购物车 */\n  addToCart: async (data: AddCartRequest): Promise<ApiResponse<CartItem>> => {\n    const res = await api.post('/cart', data);\n    return res.data;\n  },\n\n  /** 更新购物车项数量 */\n  updateCartItem: async (id: string, quantity: number): Promise<ApiResponse<CartItem>> => {\n    const res = await api.put(`/cart/${id}`, { quantity });\n    return res.data;\n  },\n\n  /** 删除购物车项 */\n  removeFromCart: async (id: string): Promise<ApiResponse<null>> => {\n    const res = await api.delete(`/cart/${id}`);\n    return res.data;\n  },\n\n  /** 清空购物车 */\n  clearCart: async (): Promise<ApiResponse<null>> => {\n    const res = await api.delete('/cart', {});\n    return res.data;\n  },\n};\n\n// =========== 订单 API ===========\n\nexport const orderApi = {\n  /** 创建订单 */\n  createOrder: async (data: CreateOrderRequest): Promise<ApiResponse<Order>> => {\n    const res = await api.post('/orders', data);\n    return res.data;\n  },\n\n  /** 获取订单列表 */\n  getOrders: async (params?: {\n    page?: number;\n    limit?: number;\n    status?: string;\n  }): Promise<PaginatedResponse<Order>> => {\n    const res = await api.get('/orders', { params });\n    return res.data;\n  },\n\n  /** 获取所有订单（管理员） */\n  getAllOrders: async (params?: {\n    page?: number;\n    limit?: number;\n    status?: string;\n  }): Promise<PaginatedResponse<Order>> => {\n    const res = await api.get('/orders/all', { params });\n    return res.data;\n  },\n\n  /** 获取订单详情 */\n  getOrderById: async (id: string): Promise<ApiResponse<Order>> => {\n    const res = await api.get(`/orders/${id}`);\n    return res.data;\n  },\n\n  /** 取消订单 */\n  cancelOrder: async (id: string): Promise<ApiResponse<Order>> => {\n    const res = await api.put(`/orders/${id}/cancel`);\n    return res.data;\n  },\n\n  /** 模拟支付 */\n  payOrder: async (id: string): Promise<ApiResponse<Order>> => {\n    const res = await api.put(`/orders/${id}/pay`);\n    return res.data;\n  },\n\n  /** 更新订单状态（管理员） */\n  updateOrderStatus: async (id: string, status: string): Promise<ApiResponse<Order>> => {\n    const res = await api.put(`/orders/${id}/status`, { status });\n    return res.data;\n  },\n};\n\nexport default api;","timestamp":1781396210,"tool_call_id":"call_a38c121d33604083bc809238","tool_name":"read_file","tool_calls":null}
{"type":"message","id":"5b382ab9-31a7-4a0b-86fe-def0b4f9ab59","role":"tool","content":"import { create } from 'zustand';\nimport type { User } from '../types';\nimport { authApi } from '../services/api';\n\n/** 认证状态接口 */\ninterface AuthState {\n  user: User | null;\n  token: string | null;\n  isAuthenticated: boolean;\n  isLoading: boolean;\n  isAdmin: boolean;\n\n  /** 初始化 - 从 localStorage 恢复登录状态 */\n  init: () => void;\n\n  /** 登录 */\n  login: (email: string, password: string) => Promise<void>;\n\n  /** 注册 */\n  register: (email: string, password: string, nickname: string) => Promise<void>;\n\n  /** 退出登录 */\n  logout: () => void;\n\n  /** 更新用户信息 */\n  updateUser: (user: User) => void;\n\n  /** 从服务端刷新用户信息 */\n  refreshProfile: () => Promise<void>;\n}\n\n/** 认证状态管理 */\nexport const useAuthStore = create<AuthState>((set, get) => ({\n  user: null,\n  token: null,\n  isAuthenticated: false,\n  isLoading: false,\n  isAdmin: false,\n\n  init: () => {\n    const token = localStorage.getItem('token');\n    const userStr = localStorage.getItem('user');\n    if (token && userStr) {\n      try {\n        const user = JSON.parse(userStr) as User;\n        set({\n          token,\n          user,\n          isAuthenticated: true,\n          isAdmin: user.role === 'admin',\n        });\n      } catch {\n        localStorage.removeItem('token');\n        localStorage.removeItem('user');\n      }\n    }\n  },\n\n  login: async (email: string, password: string) => {\n    set({ isLoading: true });\n    try {\n      const res = await authApi.login({ email, password });\n      const { token, user } = res.data;\n      localStorage.setItem('token', token);\n      localStorage.setItem('user', JSON.stringify(user));\n      set({\n        user,\n        token,\n        isAuthenticated: true,\n        isAdmin: user.role === 'admin',\n        isLoading: false,\n      });\n    } catch (error: any) {\n      set({ isLoading: false });\n      const message = error.response?.data?.message || '登录失败';\n      throw new Error(message);\n    }\n  },\n\n  register: async (email: string, password: string, nickname: string) => {\n    set({ isLoading: true });\n    try {\n      const res = await authApi.register({ email, password, nickname });\n      const { token, user } = res.data;\n      localStorage.setItem('token', token);\n      localStorage.setItem('user', JSON.stringify(user));\n      set({\n        user,\n        token,\n        isAuthenticated: true,\n        isAdmin: user.role === 'admin',\n        isLoading: false,\n      });\n    } catch (error: any) {\n      set({ isLoading: false });\n      const message = error.response?.data?.message || '注册失败';\n      throw new Error(message);\n    }\n  },\n\n  logout: () => {\n    localStorage.removeItem('token');\n    localStorage.removeItem('user');\n    set({\n      user: null,\n      token: null,\n      isAuthenticated: false,\n      isAdmin: false,\n    });\n  },\n\n  updateUser: (user: User) => {\n    localStorage.setItem('user', JSON.stringify(user));\n    set({ user, isAdmin: user.role === 'admin' });\n  },\n\n  refreshProfile: async () => {\n    try {\n      const res = await authApi.getProfile();\n      const user = res.data;\n      localStorage.setItem('user', JSON.stringify(user));\n      set({ user, isAdmin: user.role === 'admin' });\n    } catch {\n      get().logout();\n    }\n  },\n}));","timestamp":1781396210,"tool_call_id":"call_411fa5176e514d7395146dc0","tool_name":"read_file","tool_calls":null}
