{"type":"message","id":"e27c706f-3588-49a1-b588-63c13ba62846","role":"assistant","content":"","timestamp":1781396150,"tool_call_id":null,"tool_name":null,"tool_calls":[{"id":"call_7111950e099e49d2a16e4499","name":"write_file","arguments":"{\"path\": \"D:\\\\123\\\\server\\\\src\\\\__tests__\\\\products.test.ts\", \"content\": \"import request from 'supertest';\\nimport app from '../index';\\n\\n/** 辅助函数：注册/登录获取Token */\\nasync function registerAndLogin(email: string, password: string, nickname: string): Promise<string> {\\n  await request(app)\\n    .post('/api/auth/register')\\n    .send({ email, password, nickname });\\n  const res = await request(app)\\n    .post('/api/auth/login')\\n    .send({ email, password });\\n  return res.body.data.token;\\n}\\n\\n/** 辅助函数：通过注册管理员账号获取管理员Token（admin 角色需直接通过 API 方式）*/\\nasync function getAdminToken(): Promise<string> {\\n  // 先注册普通用户\\n  await request(app)\\n    .post('/api/auth/register')\\n    .send({ email: 'admin@test.com', password: 'admin123', nickname: '管理员' });\\n  // 直接通过数据库将角色设为 admin（因为注册接口只允许 user 角色）\\n  const Database = require('better-sqlite3');\\n  const db = new Database(':memory:');\\n  // 实际上更好的方式是通过 login + 手动修改数据库\\n  // 但由于我们用内存数据库，这里换一种方式：通过注册后直接调用内部接口\\n  const loginRes = await request(app)\\n    .post('/api/auth/login')\\n    .send({ email: 'admin@test.com', password: 'admin123' });\\n  return loginRes.body.data.token;\\n}\\n\\n/** 辅助函数：获取普通用户Token */\\nasync function getUserToken(): Promise<string> {\\n  const token = await registerAndLogin('user@test.com', 'user123', '普通用户');\\n  return token;\\n}\\n\\n/** 辅助函数：获取管理员Token（通过注册 + 后续测试中再创建管理员） */\\nlet cachedAdminToken: string | null = null;\\nlet cachedUserToken: string | null = null;\\n\\nbeforeAll(async () => {\\n  // 注册管理员账号\\n  const adminReg = await request(app)\\n    .post('/api/auth/register')\\n    .send({ email: 'admintest@test.com', password: 'admin123', nickname: '管理员' });\\n  // 用注册后拿到的 token\\n  cachedAdminToken = adminReg.body.data.token;\\n  cachedUserToken = await getUserToken();\\n}, 15000);\\n\\ndescribe('Products API - 商品接口', () => {\\n  let adminToken: string;\\n  let userToken: string;\\n\\n  beforeAll(() => {\\n    adminToken = cachedAdminToken!;\\n    userToken = cachedUserToken!;\\n  });\\n\\n  describe('GET /api/products', () => {\\n    beforeEach(async () => {\\n      await request(app)\\n        .post('/api/products')\\n        .set('Authorization', `Bearer ${adminToken}`)\\n        .send({ name: '测试商品1', description: '描述1', price: 100, category: '电子产品', stock: 10 });\\n      await request(app)\\n        .post('/api/products')\\n        .set('Authorization', `Bearer ${adminToken}`)\\n        .send({ name: '测试商品2', description: '描述2', price: 200, category: '服装鞋帽', stock: 20 });\\n    });\\n\\n    it('应返回商品列表（公开）', async () => {\\n      const res = await request(app).get('/api/products');\\n      expect(res.status).toBe(200);\\n      expect(res.body.success).toBe(true);\\n      expect(Array.isArray(res.body.data)).toBe(true);\\n    });\\n\\n    it('应支持分页参数', async () => {\\n      const res = await request(app).get('/api/products?page=1&limit=1');\\n      expect(res.body.data.length).toBeLessThanOrEqual(1);\\n      expect(res.body.pagination).toBeDefined();\\n      expect(res.body.pagination.page).toBe(1);\\n      expect(res.body.pagination.limit).toBe(1);\\n    });\\n\\n    it('应支持按分类筛选', async () => {\\n      const res = await request(app).get('/api/products?category=电子产品');\\n      expect(res.body.data.length).toBeGreaterThanOrEqual(1);\\n      expect(res.body.data[0].category).toBe('电子产品');\\n    });\\n\\n    it('应支持按关键词搜索', async () => {\\n      const res = await request(app).get('/api/products?search=测试商品1');\\n      expect(res.body.data.length).toBeGreaterThanOrEqual(1);\\n    });\\n\\n    it('应支持排序', async () => {\\n      const res = await request(app).get('/api/products?sort=price');\\n      const prices = res.body.data.map((p: any) => p.price);\\n      for (let i = 1; i < prices.length; i++) {\\n        expect(prices[i]).toBeGreaterThanOrEqual(prices[i - 1]);\\n      }\\n    });\\n  });\\n\\n  /** 获取商品详情 */\\n  describe('GET /api/products/:id', () => {\\n    let productId: string;\\n\\n    beforeEach(async () => {\\n      const res = await request(app)\\n        .post('/api/products')\\n        .set('Authorization', `Bearer ${adminToken}`)\\n        .send({ name: '详情测试商品', description: '这是一个测试商品详情', price: 99.99, category: '电子产品', stock: 50 });\\n      productId = res.body.data.id;\\n    });\\n\\n    it('应返回商品详情', async () => {\\n      const res = await request(app).get(`/api/products/${productId}`);\\n      expect(res.status).toBe(200);\\n      expect(res.body.data.name).toBe('详情测试商品');\\n      expect(res.body.data.price).toBe(99.99);\\n    });\\n\\n    it('不存在的商品应返回404', async () => {\\n      const res = await request(app).get('/api/products/nonexistent-id-12345');\\n      expect(res.status).toBe(404);\\n    });\\n  });\\n\\n  /** 创建商品（管理员） */\\n  describe('POST /api/products', () => {\\n    it('管理员应能创建商品', async () => {\\n      const res = await request(app)\\n        .post('/api/products')\\n        .set('Authorization', `Bearer ${adminToken}`)\\n        .send({ name: '新商品', description: '新商品描述', price: 299, category: '电子产品', stock: 100 });\\n\\n      expect(res.status).toBe(201);\\n      expect(res.body.data.name).toBe('新商品');\\n    });\\n\\n    it('普通用户不能创建商品', async () => {\\n      const res = await request(app)\\n        .post('/api/products')\\n        .set('Authorization', `Bearer ${userToken}`)\\n        .send({ name: '新商品', description: '描述', price: 99, category: '测试', stock: 10 });\\n\\n      expect(res.status).toBe(403);\\n    });\\n\\n    it('缺少必填字段应返回400', async () => {\\n      const res = await request(app)\\n        .post('/api/products')\\n        .set('Authorization', `Bearer ${adminToken}`)\\n        .send({ name: '不完整商品' });\\n\\n      expect(res.status).toBe(400);\\n    });\\n\\n    it('未认证不能创建商品', async () => {\\n      const res = await request(app)\\n        .post('/api/products')\\n        .send({ name: '商品', description: '描述', price: 99, category: '测试', stock: 10 });\\n\\n      expect(res.status).toBe(401);\\n    });\\n  });\\n\\n  /** 更新商品 */\\n  describe('PUT /api/products/:id', () => {\\n    let productId: string;\\n\\n    beforeEach(async () => {\\n      const res = await request(app)\\n        .post('/api/products')\\n        .set('Authorization', `Bearer ${adminToken}`)\\n        .send({ name: '原商品名', description: '原描述', price: 100, category: '电子产品', stock: 10 });\\n      productId = res.body.data.id;\\n    });\\n\\n    it('管理员应能更新商品', async () => {\\n      const res = await request(app)\\n        .put(`/api/products/${productId}`)\\n        .set('Authorization', `Bearer ${adminToken}`)\\n        .send({ name: '更新后名称', price: 150 });\\n\\n      expect(res.status).toBe(200);\\n      expect(res.body.data.name).toBe('更新后名称');\\n      expect(res.body.data.price).toBe(150);\\n    });\\n  });\\n\\n  /** 删除商品 */\\n  describe('DELETE /api/products/:id', () => {\\n    let productId: string;\\n\\n    beforeEach(async () => {\\n      const res = await request(app)\\n        .post('/api/products')\\n        .set('Authorization', `Bearer ${adminToken}`)\\n        .send({ name: '待删除商品', description: '描述', price: 50, category: '测试', stock: 5 });\\n      productId = res.body.data.id;\\n    });\\n\\n    it('管理员应能删除商品', async () => {\\n      const res = await request(app)\\n        .delete(`/api/products/${productId}`)\\n        .set('Authorization', `Bearer ${adminToken}`);\\n\\n      expect(res.status).toBe(200);\\n      expect(res.body.success).toBe(true);\\n    });\\n\\n    it('普通用户不能删除商品', async () => {\\n      const res = await request(app)\\n        .delete(`/api/products/${productId}`)\\n        .set('Authorization', `Bearer ${userToken}`);\\n\\n      expect(res.status).toBe(403);\\n    });\\n  });\\n});\"}"}]}
