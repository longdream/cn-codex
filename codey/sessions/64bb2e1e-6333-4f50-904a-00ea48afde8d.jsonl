{"type":"message","id":"e86f8699-f4b3-478f-8b27-277487e245ed","role":"tool","content":"/** 用户信息 */\nexport interface User {\n  _id: string;\n  email: string;\n  nickname: string;\n  avatar: string;\n  role: 'user' | 'admin';\n  addresses: Address[];\n  isActive: boolean;\n  createdAt: string;\n  updatedAt: string;\n}\n\n/** 地址 */\nexport interface Address {\n  name: string;\n  phone: string;\n  province: string;\n  city: string;\n  district: string;\n  detail: string;\n  isDefault: boolean;\n}\n\n/** 商品 */\nexport interface Product {\n  _id: string;\n  name: string;\n  description: string;\n  price: number;\n  originalPrice: number;\n  images: string[];\n  category: string;\n  stock: number;\n  sales: number;\n  rating: number;\n  status: 'active' | 'inactive';\n  createdAt: string;\n  updatedAt: string;\n}\n\n/** 购物车项 */\nexport interface CartItem {\n  _id: string;\n  userId: string;\n  productId: Product | string;\n  quantity: number;\n  createdAt: string;\n  updatedAt: string;\n}\n\n/** 订单商品 */\nexport interface OrderItem {\n  productId: string;\n  productName: string;\n  price: number;\n  quantity: number;\n  image: string;\n}\n\n/** 收货地址（简化） */\nexport interface ShippingAddress {\n  name: string;\n  phone: string;\n  detail: string;\n}\n\n/** 订单 */\nexport interface Order {\n  _id: string;\n  orderNo: string;\n  userId: string | User;\n  items: OrderItem[];\n  totalAmount: number;\n  status: 'pending' | 'paid' | 'shipped' | 'delivered' | 'cancelled';\n  shippingAddress: ShippingAddress;\n  paidAt?: string;\n  createdAt: string;\n  updatedAt: string;\n}\n\n/** API 响应通用格式 */\nexport interface ApiResponse<T = any> {\n  success: boolean;\n  data: T;\n  message?: string;\n  error?: string;\n  errors?: string[];\n}\n\n/** 分页响应 */\nexport interface PaginatedResponse<T = any> {\n  success: boolean;\n  data: T[];\n  pagination: {\n    page: number;\n    limit: number;\n    total: number;\n    pages: number;\n  };\n}\n\n/** 登录请求 */\nexport interface LoginRequest {\n  email: string;\n  password: string;\n}\n\n/** 注册请求 */\nexport interface RegisterRequest {\n  email: string;\n  password: string;\n  nickname: string;\n}\n\n/** 购物车添加请求 */\nexport interface AddCartRequest {\n  productId: string;\n  quantity: number;\n}\n\n/** 创建订单请求 */\nexport interface CreateOrderRequest {\n  items: { productId: string; quantity: number }[];\n  shippingAddress: ShippingAddress;\n}","timestamp":1781396212,"tool_call_id":"call_32bafcf6ff944aacafa34791","tool_name":"read_file","tool_calls":null}
