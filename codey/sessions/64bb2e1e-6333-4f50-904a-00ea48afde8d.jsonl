{"type":"message","id":"b39fabdf-3af7-42d2-8047-cfe0970ed3c1","role":"tool","content":"import { initDB, getDB, closeDB } from '../config/database';\nimport { generateId } from '../utils/order';\nimport bcrypt from 'bcryptjs';\n\n/** 种子数据 - 管理员 */\nconst adminUser = {\n  id: generateId(),\n  email: 'admin@shopease.com',\n  password: 'admin123',\n  nickname: '管理员',\n  role: 'admin' as const,\n};\n\n/** 种子数据 - 测试用户 */\nconst testUser = {\n  id: generateId(),\n  email: 'user@shopease.com',\n  password: 'user123',\n  nickname: '测试用户',\n  role: 'user' as const,\n};\n\n/** 种子数据 - 商品列表 */\nconst sampleProducts = [\n  {\n    name: 'iPhone 15 Pro Max',\n    description:\n      '搭载 A17 Pro 芯片，钛金属设计，4800 万像素主摄系统，支持 USB-C 接口。超视网膜 XDR 显示屏，ProMotion 自适应刷新率技术。',\n    price: 9999,\n    originalPrice: 11999,\n    images: ['https://picsum.photos/seed/iphone15/400/400', 'https://picsum.photos/seed/iphone15-2/400/400'],\n    category: '电子产品',\n    stock: 100,\n    sales: 256,\n    rating: 4.8,\n  },\n  {\n    name: 'MacBook Pro 14英寸',\n    description:\n      'M3 Pro 芯片，18GB 统一内存，512GB 固态硬盘。Liquid 视网膜 XDR 显示屏，长达 17 小时电池续航。',\n    price: 14999,\n    originalPrice: 16999,\n    images: ['https://picsum.photos/seed/macbook/400/400', 'https://picsum.photos/seed/macbook-2/400/400'],\n    category: '电子产品',\n    stock: 50,\n    sales: 128,\n    rating: 4.9,\n  },\n  {\n    name: 'Sony WH-1000XM5 降噪耳机',\n    description:\n      '业界领先的降噪技术，30小时续航，快速充电。佩戴舒适，支持多点连接，高解析度音频。',\n    price: 2499,\n    originalPrice: 2999,\n    images: ['https://picsum.photos/seed/sony/400/400', 'https://picsum.photos/seed/sony-2/400/400'],\n    category: '电子产品',\n    stock: 200,\n    sales: 512,\n    rating: 4.7,\n  },\n  {\n    name: '经典纯棉T恤 男女同款',\n    description:\n      '100% 精梳棉，柔软亲肤，透气排汗。经典圆领设计，多种颜色可选，百搭日常穿着。',\n    price: 99,\n    originalPrice: 199,\n    images: ['https://picsum.photos/seed/tshirt/400/400', 'https://picsum.photos/seed/tshirt-2/400/400'],\n    category: '服装鞋帽',\n    stock: 500,\n    sales: 1820,\n    rating: 4.5,\n  },\n  {\n    name: '冬季加厚羽绒服',\n    description:\n      '90% 白鹅绒填充，蓬松保暖。防风防泼水面料，可脱卸帽设计，多口袋实用收纳。',\n    price: 899,\n    originalPrice: 1299,\n    images: ['https://picsum.photos/seed/jacket/400/400', 'https://picsum.photos/seed/jacket-2/400/400'],\n    category: '服装鞋帽',\n    stock: 150,\n    sales: 386,\n    rating: 4.6,\n  },\n  {\n    name: '《深入理解计算机系统》原书第3版',\n    description:\n      '计算机科学经典教材，从程序员视角深入理解计算机系统。涵盖数据表示、机器级程序、处理器体系结构等核心主题。',\n    price: 89,\n    originalPrice: 129,\n    images: ['https://picsum.photos/seed/csbook/400/400', 'https://picsum.photos/seed/csbook-2/400/400'],\n    category: '图书文具',\n    stock: 300,\n    sales: 892,\n    rating: 4.9,\n  },\n  {\n    name: '北欧风简约台灯',\n    description:\n      'LED 护眼台灯，三档色温调节，无频闪，无蓝光危害。触摸开关，记忆亮度，适合阅读办公。',\n    price: 159,\n    originalPrice: 229,\n    images: ['https://picsum.photos/seed/lamp/400/400', 'https://picsum.photos/seed/lamp-2/400/400'],\n    category: '家居生活',\n    stock: 180,\n    sales: 456,\n    rating: 4.4,\n  },\n  {\n    name: '日本进口抹茶粉 100g',\n    description:\n      '宇治抹茶粉，石磨研磨，色泽翠绿，口感醇厚。适合冲泡饮用、烘焙甜点、制作抹茶拿铁。',\n    price: 68,\n    originalPrice: 88,\n    images: ['https://picsum.photos/seed/matcha/400/400', 'https://picsum.photos/seed/matcha-2/400/400'],\n    category: '食品饮料',\n    stock: 400,\n    sales: 1205,\n    rating: 4.7,\n  },\n  {\n    name: '机械键盘 Cherry MX 青轴',\n    description:\n      '87键紧凑布局，Cherry MX 青轴，段落感清脆。PBT 键帽，RGB 背光，Type-C 可拆卸线缆。',\n    price: 399,\n    originalPrice: 599,\n    images: ['https://picsum.photos/seed/keyboard/400/400', 'https://picsum.photos/seed/keyboard-2/400/400'],\n    category: '电子产品',\n    stock: 120,\n    sales: 678,\n    rating: 4.6,\n  },\n  {\n    name: '运动跑步鞋 透气减震',\n    description:\n      '飞织鞋面，轻盈透气。EVA 中底加橡胶大底，减震回弹。适合跑步、健身、日常穿着。',\n    price: 259,\n    originalPrice: 359,\n    images: ['https://picsum.photos/seed/shoes/400/400', 'https://picsum.photos/seed/shoes-2/400/400'],\n    category: '服装鞋帽',\n    stock: 250,\n    sales: 956,\n    rating: 4.5,\n  },\n  {\n    name: '便携蓝牙音箱 IPX7防水',\n    description:\n      'IPX7 级防水，户外便携。20W 大功率，360°环绕立体声，12小时续航。支持TWS串联。',\n    price: 199,\n    originalPrice: 299,\n    images: ['https://picsum.photos/seed/speaker/400/400', 'https://picsum.photos/seed/speaker-2/400/400'],\n    category: '电子产品',\n    stock: 160,\n    sales: 734,\n    rating: 4.3,\n  },\n  {\n    name: '智能手环 心率血氧监测',\n    description:\n      '1.47英寸 AMOLED 屏幕，全天候心率血氧监测。100+ 运动模式，14天超长续航，IP68防水。',\n    price: 179,\n    originalPrice: 249,\n    images: ['https://picsum.photos/seed/band/400/400', 'https://picsum.photos/seed/band-2/400/400'],\n    category: '电子产品',\n    stock: 300,\n    sales: 1123,\n    rating: 4.4,\n  },\n];\n\nasync function seed() {\n  try {\n    console.log('🔄 初始化数据库...');\n    initDB();\n    const db = getDB();\n    console.log('✅ 数据库已连接\\n');\n\n    // 清空数据（注意外键约束顺序）\n    console.log('🔄 清空现有数据...');\n    db.exec('PRAGMA foreign_keys = OFF');\n    db.exec(`\n      DELETE FROM order_items;\n      DELETE FROM orders;\n      DELETE FROM cart_items;\n      DELETE FROM products;\n      DELETE FROM addresses;\n      DELETE FROM users;\n    `);\n    db.exec('PRAGMA foreign_keys = ON');\n    console.log('✅ 数据已清空\\n');\n\n    // 创建管理员\n    console.log('👤 创建管理员账号...');\n    const adminHashed = await bcrypt.hash(adminUser.password, 10);\n    db.prepare(\n      'INSERT INTO users (id, email, password, nickname, role) VALUES (?, ?, ?, ?, ?)'\n    ).run(adminUser.id, adminUser.email, adminHashed, adminUser.nickname, adminUser.role);\n    console.log(`   ✅ 管理员: ${adminUser.email} / ${adminUser.password}`);\n\n    // 创建测试用户\n    console.log('👤 创建测试用户...');\n    const userHashed = await bcrypt.hash(testUser.password, 10);\n    db.prepare(\n      'INSERT INTO users (id, email, password, nickname, role) VALUES (?, ?, ?, ?, ?)'\n    ).run(testUser.id, testUser.email, userHashed, testUser.nickname, testUser.role);\n    console.log(`   ✅ 测试用户: ${testUser.email} / ${testUser.password}\\n`);\n\n    // 添加测试用户地址\n    db.prepare(`\n      INSERT INTO addresses (id, user_id, name, phone, province, city, district, detail, is_default)\n      VALUES (?, ?, ?, ?, ?, ?, ?, ?, 1)\n    `).run(generateId(), testUser.id, '张三', '13800138000', '广东省', '深圳市', '南山区', '科技园南区A栋1001室');\n    console.log('   ✅ 已添加测试用户地址\\n');\n\n    // 创建商品\n    console.log('📦 创建商品...');\n    const insertProduct = db.prepare(`\n      INSERT INTO products (id, name, description, price, original_price, images, category, stock, sales, rating)\n      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)\n    `);\n\n    const createdProductIds: string[] = [];\n    for (const p of sampleProducts) {\n      const id = generateId();\n      insertProduct.run(\n        id, p.name, p.description, p.price, p.originalPrice,\n        JSON.stringify(p.images), p.category, p.stock, p.sales, p.rating\n      );\n      createdProductIds.push(id);\n    }\n    console.log(`   ✅ 已创建 ${createdProductIds.length} 个商品\\n`);\n\n    // 添加一些商品到测试用户的购物车\n    console.log('🛒 添加购物车示例数据...');\n    const insertCart = db.prepare(\n      'INSERT INTO cart_items (id, user_id, product_id, quantity) VALUES (?, ?, ?, ?)'\n    );\n    const cartItems = [\n      { productIdx: 0, quantity: 1 },\n      { productIdx: 2, quantity: 2 },\n      { productIdx: 3, quantity: 3 },\n    ];\n    for (const ci of cartItems) {\n      insertCart.run(generateId(), testUser.id, createdProductIds[ci.productIdx], ci.quantity);\n    }\n    console.log(`   ✅ 已添加 ${cartItems.length} 个购物车项\\n`);\n\n    console.log('🎉  种子数据导入完成！');\n    console.log('━━━━━━━━━━━━━━━━━━━━━━━━');\n    console.log('管理员: admin@shopease.com / admin123');\n    console.log('测试用户: user@shopease.com / user123');\n    console.log('━━━━━━━━━━━━━━━━━━━━━━━━\\n');\n\n    closeDB();\n    process.exit(0);\n  } catch (error) {\n    console.error('❌ 种子数据导入失败:', error);\n    closeDB();\n    process.exit(1);\n  }\n}\n\nseed();","timestamp":1781396943,"tool_call_id":"call_a6920070c6f446a499dd3dd5","tool_name":"read_file","tool_calls":null}
{"type":"message","id":"d78fdaba-9fca-4f0f-819e-b1a0809bbe78","role":"tool","content":"{\n  \"name\": \"ecommerce-server\",\n  \"version\": \"1.0.0\",\n  \"description\": \"ShopEase 商城后端服务\",\n  \"main\": \"dist/index.js\",\n  \"scripts\": {\n    \"dev\": \"ts-node-dev --respawn --transpile-only src/index.ts\",\n    \"build\": \"tsc\",\n    \"start\": \"node dist/index.js\",\n    \"test\": \"jest --forceExit --detectOpenHandles\",\n    \"test:watch\": \"jest --watch --forceExit\",\n    \"test:coverage\": \"jest --coverage --forceExit\",\n    \"seed\": \"ts-node src/scripts/seed.ts\",\n    \"migrate\": \"ts-node src/scripts/migrate.ts\"\n  },\n  \"dependencies\": {\n    \"bcryptjs\": \"^2.4.3\",\n    \"better-sqlite3\": \"^11.6.0\",\n    \"cors\": \"^2.8.5\",\n    \"dotenv\": \"^16.3.1\",\n    \"express\": \"^4.18.2\",\n    \"express-validator\": \"^7.0.1\",\n    \"jsonwebtoken\": \"^9.0.2\",\n    \"uuid\": \"^9.0.1\"\n  },\n  \"devDependencies\": {\n    \"@types/bcryptjs\": \"^2.4.6\",\n    \"@types/better-sqlite3\": \"^7.6.12\",\n    \"@types/cors\": \"^2.8.17\",\n    \"@types/express\": \"^4.17.21\",\n    \"@types/jest\": \"^29.5.11\",\n    \"@types/jsonwebtoken\": \"^9.0.5\",\n    \"@types/node\": \"^20.10.4\",\n    \"@types/supertest\": \"^2.0.16\",\n    \"@types/uuid\": \"^9.0.7\",\n    \"jest\": \"^29.7.0\",\n    \"supertest\": \"^6.3.3\",\n    \"ts-jest\": \"^29.1.1\",\n    \"ts-node\": \"^10.9.2\",\n    \"ts-node-dev\": \"^2.0.0\",\n    \"typescript\": \"^5.3.3\"\n  }\n}","timestamp":1781396943,"tool_call_id":"call_354c17fa1139430b8d9cf4c1","tool_name":"read_file","tool_calls":null}
