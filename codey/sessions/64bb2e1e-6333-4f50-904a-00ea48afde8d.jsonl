{"type":"message","id":"387e3110-29d8-4a36-840c-56fda23a8b7b","role":"tool","content":"import mongoose from 'mongoose';\nimport { MongoMemoryServer } from 'mongodb-memory-server';\nimport app from '../index';\n\nlet mongoServer: MongoMemoryServer;\n\n/** 测试前启动内存数据库 */\nbeforeAll(async () => {\n  mongoServer = await MongoMemoryServer.create();\n  const uri = mongoServer.getUri();\n  await mongoose.connect(uri);\n});\n\n/** 测试后清理数据 */\nafterEach(async () => {\n  const collections = mongoose.connection.collections;\n  for (const key in collections) {\n    await collections[key].deleteMany({});\n  }\n});\n\n/** 测试后断开连接 */\nafterAll(async () => {\n  await mongoose.connection.close();\n  if (mongoServer) {\n    await mongoServer.stop();\n  }\n});\n\nexport { app };","timestamp":1781396123,"tool_call_id":"call_0992ccebad694f338752d683","tool_name":"read_file","tool_calls":null}
{"type":"message","id":"2398f3f9-493e-44fc-b89b-857ea7a62ef0","role":"tool","content":"import request from 'supertest';\nimport app from '../index';\nimport { User } from '../models';\n\n/** 辅助函数：创建管理员并获取Token */\nasync function getAdminToken(): Promise<string> {\n  await User.create({\n    email: 'admin@test.com',\n    password: 'admin123',\n    nickname: '管理员',\n    role: 'admin',\n  });\n  const res = await request(app)\n    .post('/api/auth/login')\n    .send({ email: 'admin@test.com', password: 'admin123' });\n  return res.body.data.token;\n}\n\n/** 辅助函数：创建普通用户并获取Token */\nasync function getUserToken(): Promise<string> {\n  await User.create({\n    email: 'user@test.com',\n    password: 'user123',\n    nickname: '普通用户',\n  });\n  const res = await request(app)\n    .post('/api/auth/login')\n    .send({ email: 'user@test.com', password: 'user123' });\n  return res.body.data.token;\n}\n\ndescribe('Products API - 商品接口', () => {\n  let adminToken: string;\n  let userToken: string;\n\n  beforeAll(async () => {\n    adminToken = await getAdminToken();\n    userToken = await getUserToken();\n  });\n\n  /** 获取商品列表 */\n  describe('GET /api/products', () => {\n    beforeEach(async () => {\n      // 创建测试商品\n      await request(app)\n        .post('/api/products')\n        .set('Authorization', `Bearer ${adminToken}`)\n        .send({\n          name: '测试商品1',\n          description: '描述1',\n          price: 100,\n          category: '电子产品',\n          stock: 10,\n        });\n      await request(app)\n        .post('/api/products')\n        .set('Authorization', `Bearer ${adminToken}`)\n        .send({\n          name: '测试商品2',\n          description: '描述2',\n          price: 200,\n          category: '服装鞋帽',\n          stock: 20,\n        });\n    });\n\n    it('应返回商品列表（公开）', async () => {\n      const res = await request(app).get('/api/products');\n      expect(res.status).toBe(200);\n      expect(res.body.success).toBe(true);\n      expect(Array.isArray(res.body.data)).toBe(true);\n    });\n\n    it('应支持分页参数', async () => {\n      const res = await request(app).get('/api/products?page=1&limit=1');\n      expect(res.body.data.length).toBeLessThanOrEqual(1);\n      expect(res.body.pagination).toBeDefined();\n      expect(res.body.pagination.page).toBe(1);\n      expect(res.body.pagination.limit).toBe(1);\n    });\n\n    it('应支持按分类筛选', async () => {\n      const res = await request(app).get('/api/products?category=电子产品');\n      expect(res.body.data).toHaveLength(1);\n      expect(res.body.data[0].category).toBe('电子产品');\n    });\n\n    it('应支持按关键词搜索', async () => {\n      const res = await request(app).get('/api/products?search=测试商品1');\n      expect(res.body.data.length).toBeGreaterThanOrEqual(1);\n    });\n\n    it('应支持排序', async () => {\n      const res = await request(app).get('/api/products?sort=price');\n      const prices = res.body.data.map((p: any) => p.price);\n      for (let i = 1; i < prices.length; i++) {\n        expect(prices[i]).toBeGreaterThanOrEqual(prices[i - 1]);\n      }\n    });\n  });\n\n  /** 获取商品详情 */\n  describe('GET /api/products/:id', () => {\n    let productId: string;\n\n    beforeEach(async () => {\n      const res = await request(app)\n        .post('/api/products')\n        .set('Authorization', `Bearer ${adminToken}`)\n        .send({\n          name: '详情测试商品',\n          description: '这是一个测试商品详情',\n          price: 99.99,\n          category: '电子产品',\n          stock: 50,\n        });\n      productId = res.body.data._id;\n    });\n\n    it('应返回商品详情', async () => {\n      const res = await request(app).get(`/api/products/${productId}`);\n      expect(res.status).toBe(200);\n      expect(res.body.data.name).toBe('详情测试商品');\n      expect(res.body.data.price).toBe(99.99);\n    });\n\n    it('不存在的商品应返回404', async () => {\n      const res = await request(app).get('/api/products/000000000000000000000000');\n      expect(res.status).toBe(404);\n    });\n  });\n\n  /** 创建商品（管理员） */\n  describe('POST /api/products', () => {\n    it('管理员应能创建商品', async () => {\n      const res = await request(app)\n        .post('/api/products')\n        .set('Authorization', `Bearer ${adminToken}`)\n        .send({\n          name: '新商品',\n          description: '新商品描述',\n          price: 299,\n          category: '电子产品',\n          stock: 100,\n        });\n\n      expect(res.status).toBe(201);\n      expect(res.body.data.name).toBe('新商品');\n    });\n\n    it('普通用户不能创建商品', async () => {\n      const res = await request(app)\n        .post('/api/products')\n        .set('Authorization', `Bearer ${userToken}`)\n        .send({\n          name: '新商品',\n          description: '描述',\n          price: 99,\n          category: '测试',\n          stock: 10,\n        });\n\n      expect(res.status).toBe(403);\n    });\n\n    it('缺少必填字段应返回400', async () => {\n      const res = await request(app)\n        .post('/api/products')\n        .set('Authorization', `Bearer ${adminToken}`)\n        .send({ name: '不完整商品' });\n\n      expect(res.status).toBe(400);\n    });\n\n    it('未认证不能创建商品', async () => {\n      const res = await request(app)\n        .post('/api/products')\n        .send({ name: '商品', description: '描述', price: 99, category: '测试', stock: 10 });\n\n      expect(res.status).toBe(401);\n    });\n  });\n\n  /** 更新商品 */\n  describe('PUT /api/products/:id', () => {\n    let productId: string;\n\n    beforeEach(async () => {\n      const res = await request(app)\n        .post('/api/products')\n        .set('Authorization', `Bearer ${adminToken}`)\n        .send({\n          name: '原商品名',\n          description: '原描述',\n          price: 100,\n          category: '电子产品',\n          stock: 10,\n        });\n      productId = res.body.data._id;\n    });\n\n    it('管理员应能更新商品', async () => {\n      const res = await request(app)\n        .put(`/api/products/${productId}`)\n        .set('Authorization', `Bearer ${adminToken}`)\n        .send({ name: '更新后名称', price: 150 });\n\n      expect(res.status).toBe(200);\n      expect(res.body.data.name).toBe('更新后名称');\n      expect(res.body.data.price).toBe(150);\n    });\n  });\n\n  /** 删除商品 */\n  describe('DELETE /api/products/:id', () => {\n    let productId: string;\n\n    beforeEach(async () => {\n      const res = await request(app)\n        .post('/api/products')\n        .set('Authorization', `Bearer ${adminToken}`)\n        .send({\n          name: '待删除商品',\n          description: '描述',\n          price: 50,\n          category: '测试',\n          stock: 5,\n        });\n      productId = res.body.data._id;\n    });\n\n    it('管理员应能删除商品', async () => {\n      const res = await request(app)\n        .delete(`/api/products/${productId}`)\n        .set('Authorization', `Bearer ${adminToken}`);\n\n      expect(res.status).toBe(200);\n      expect(res.body.success).toBe(true);\n    });\n\n    it('普通用户不能删除商品', async () => {\n      const res = await request(app)\n        .delete(`/api/products/${productId}`)\n        .set('Authorization', `Bearer ${userToken}`);\n\n      expect(res.status).toBe(403);\n    });\n  });\n});","timestamp":1781396123,"tool_call_id":"call_90e93a761d4043aea9937554","tool_name":"read_file","tool_calls":null}
{"type":"message","id":"48b90d38-3781-46fa-8168-ccc4a5068f79","role":"tool","content":"import request from 'supertest';\nimport app from '../index';\nimport { User } from '../models';\n\n/** 辅助函数 */\nasync function setupTestData() {\n  // 创建用户\n  await User.create({\n    email: 'cart@test.com',\n    password: 'password123',\n    nickname: '购物车测试',\n  });\n  const loginRes = await request(app)\n    .post('/api/auth/login')\n    .send({ email: 'cart@test.com', password: 'password123' });\n  const token = loginRes.body.data.token;\n  const userId = loginRes.body.data.user._id;\n\n  // 创建商品\n  await User.create({\n    email: 'admin-cart@test.com',\n    password: 'admin123',\n    nickname: '管理员',\n    role: 'admin',\n  });\n  const adminLogin = await request(app)\n    .post('/api/auth/login')\n    .send({ email: 'admin-cart@test.com', password: 'admin123' });\n  const adminToken = adminLogin.body.data.token;\n\n  const prodRes = await request(app)\n    .post('/api/products')\n    .set('Authorization', `Bearer ${adminToken}`)\n    .send({\n      name: '购物车测试商品',\n      description: '测试用商品',\n      price: 50,\n      category: '电子产品',\n      stock: 100,\n    });\n  const productId = prodRes.body.data._id;\n\n  return { token, userId, adminToken, productId };\n}\n\ndescribe('Cart API - 购物车接口', () => {\n  let token: string;\n  let productId: string;\n\n  beforeAll(async () => {\n    const data = await setupTestData();\n    token = data.token;\n    productId = data.productId;\n  });\n\n  /** 添加到购物车 */\n  describe('POST /api/cart', () => {\n    it('应添加商品到购物车', async () => {\n      const res = await request(app)\n        .post('/api/cart')\n        .set('Authorization', `Bearer ${token}`)\n        .send({ productId, quantity: 2 });\n\n      // 201 (新建) 或 200 (已存在更新)\n      expect([200, 201]).toContain(res.status);\n      expect(res.body.success).toBe(true);\n    });\n\n    it('未认证不能添加购物车', async () => {\n      const res = await request(app)\n        .post('/api/cart')\n        .send({ productId, quantity: 1 });\n\n      expect(res.status).toBe(401);\n    });\n\n    it('数量为0应返回400', async () => {\n      const res = await request(app)\n        .post('/api/cart')\n        .set('Authorization', `Bearer ${token}`)\n        .send({ productId, quantity: 0 });\n\n      expect(res.status).toBe(400);\n    });\n\n    it('不存在的商品应返回404', async () => {\n      const res = await request(app)\n        .post('/api/cart')\n        .set('Authorization', `Bearer ${token}`)\n        .send({ productId: '000000000000000000000000', quantity: 1 });\n\n      expect(res.status).toBe(404);\n    });\n  });\n\n  /** 获取购物车 */\n  describe('GET /api/cart', () => {\n    it('应返回购物车列表', async () => {\n      // 先添加一个商品\n      await request(app)\n        .post('/api/cart')\n        .set('Authorization', `Bearer ${token}`)\n        .send({ productId, quantity: 1 });\n\n      const res = await request(app)\n        .get('/api/cart')\n        .set('Authorization', `Bearer ${token}`);\n\n      expect(res.status).toBe(200);\n      expect(res.body.success).toBe(true);\n      expect(Array.isArray(res.body.data)).toBe(true);\n    });\n  });\n\n  /** 更新购物车项 */\n  describe('PUT /api/cart/:id', () => {\n    let cartItemId: string;\n\n    beforeEach(async () => {\n      // 确保购物车中至少有一项\n      const addRes = await request(app)\n        .post('/api/cart')\n        .set('Authorization', `Bearer ${token}`)\n        .send({ productId, quantity: 1 });\n\n      const cartRes = await request(app)\n        .get('/api/cart')\n        .set('Authorization', `Bearer ${token}`);\n\n      if (cartRes.body.data.length > 0) {\n        cartItemId = cartRes.body.data[0]._id;\n      }\n    });\n\n    it('应更新购物车项数量', async () => {\n      if (!cartItemId) return;\n      const res = await request(app)\n        .put(`/api/cart/${cartItemId}`)\n        .set('Authorization', `Bearer ${token}`)\n        .send({ quantity: 5 });\n\n      expect(res.status).toBe(200);\n      expect(res.body.data.quantity).toBe(5);\n    });\n  });\n\n  /** 删除购物车项 */\n  describe('DELETE /api/cart/:id', () => {\n    it('应删除购物车项', async () => {\n      // 先添加\n      await request(app)\n        .post('/api/cart')\n        .set('Authorization', `Bearer ${token}`)\n        .send({ productId, quantity: 1 });\n\n      const cartRes = await request(app)\n        .get('/api/cart')\n        .set('Authorization', `Bearer ${token}`);\n\n      if (cartRes.body.data.length > 0) {\n        const itemId = cartRes.body.data[0]._id;\n        const res = await request(app)\n          .delete(`/api/cart/${itemId}`)\n          .set('Authorization', `Bearer ${token}`);\n\n        expect(res.status).toBe(200);\n        expect(res.body.success).toBe(true);\n      }\n    });\n  });\n});","timestamp":1781396123,"tool_call_id":"call_0f3d46dad9b84a7c89f804cd","tool_name":"read_file","tool_calls":null}
{"type":"message","id":"0bcef980-9936-4a37-b56c-765280f69338","role":"tool","content":"import request from 'supertest';\nimport app from '../index';\nimport { User } from '../models';\n\nasync function setupTestData() {\n  // 管理员登录\n  await User.create({\n    email: 'admin-order@test.com', password: 'admin123', nickname: '管理员', role: 'admin',\n  });\n  const adminLogin = await request(app)\n    .post('/api/auth/login')\n    .send({ email: 'admin-order@test.com', password: 'admin123' });\n  const adminToken = adminLogin.body.data.token;\n\n  // 创建商品\n  const prodRes = await request(app)\n    .post('/api/products')\n    .set('Authorization', `Bearer ${adminToken}`)\n    .send({ name: '订单测试商品', description: '测试', price: 100, category: '电子产品', stock: 50 });\n  const productId = prodRes.body.data._id;\n\n  // 创建商品2\n  const prodRes2 = await request(app)\n    .post('/api/products')\n    .set('Authorization', `Bearer ${adminToken}`)\n    .send({ name: '订单测试商品2', description: '测试2', price: 200, category: '服装鞋帽', stock: 30 });\n  const productId2 = prodRes2.body.data._id;\n\n  // 创建用户\n  await User.create({\n    email: 'order@test.com', password: 'password123', nickname: '订单测试',\n  });\n  const loginRes = await request(app)\n    .post('/api/auth/login')\n    .send({ email: 'order@test.com', password: 'password123' });\n  const token = loginRes.body.data.token;\n\n  return { token, adminToken, productId, productId2 };\n}\n\ndescribe('Orders API - 订单接口', () => {\n  let token: string;\n  let adminToken: string;\n  let productId: string;\n  let productId2: string;\n\n  beforeAll(async () => {\n    const data = await setupTestData();\n    token = data.token;\n    adminToken = data.adminToken;\n    productId = data.productId;\n    productId2 = data.productId2;\n  });\n\n  /** 创建订单 */\n  describe('POST /api/orders', () => {\n    it('应成功创建订单', async () => {\n      const res = await request(app)\n        .post('/api/orders')\n        .set('Authorization', `Bearer ${token}`)\n        .send({\n          items: [\n            { productId, quantity: 2 },\n            { productId: productId2, quantity: 1 },\n          ],\n          shippingAddress: {\n            name: '张三',\n            phone: '13800138000',\n            detail: '广东省深圳市南山区科技园',\n          },\n        });\n\n      expect(res.status).toBe(201);\n      expect(res.body.success).toBe(true);\n      expect(res.body.data).toHaveProperty('orderNo');\n      expect(res.body.data.totalAmount).toBe(400); // 100*2 + 200*1\n      expect(res.body.data.status).toBe('pending');\n      expect(res.body.data.items).toHaveLength(2);\n    });\n\n    it('未认证不能创建订单', async () => {\n      const res = await request(app)\n        .post('/api/orders')\n        .send({ items: [{ productId, quantity: 1 }], shippingAddress: { name: '测试', phone: '123', detail: '地址' } });\n\n      expect(res.status).toBe(401);\n    });\n\n    it('空商品列表应返回400', async () => {\n      const res = await request(app)\n        .post('/api/orders')\n        .set('Authorization', `Bearer ${token}`)\n        .send({ items: [], shippingAddress: { name: '测试', phone: '123', detail: '地址' } });\n\n      expect(res.status).toBe(400);\n    });\n\n    it('缺少收货地址应返回400', async () => {\n      const res = await request(app)\n        .post('/api/orders')\n        .set('Authorization', `Bearer ${token}`)\n        .send({ items: [{ productId, quantity: 1 }] });\n\n      expect(res.status).toBe(400);\n    });\n  });\n\n  /** 获取订单列表 */\n  describe('GET /api/orders', () => {\n    beforeEach(async () => {\n      await request(app)\n        .post('/api/orders')\n        .set('Authorization', `Bearer ${token}`)\n        .send({\n          items: [{ productId, quantity: 1 }],\n          shippingAddress: { name: '李四', phone: '13900139000', detail: '北京市朝阳区' },\n        });\n    });\n\n    it('应返回用户订单列表', async () => {\n      const res = await request(app)\n        .get('/api/orders')\n        .set('Authorization', `Bearer ${token}`);\n\n      expect(res.status).toBe(200);\n      expect(res.body.success).toBe(true);\n      expect(Array.isArray(res.body.data)).toBe(true);\n      expect(res.body.data.length).toBeGreaterThanOrEqual(1);\n    });\n  });\n\n  /** 模拟支付 */\n  describe('PUT /api/orders/:id/pay', () => {\n    let orderId: string;\n\n    beforeEach(async () => {\n      const res = await request(app)\n        .post('/api/orders')\n        .set('Authorization', `Bearer ${token}`)\n        .send({\n          items: [{ productId, quantity: 1 }],\n          shippingAddress: { name: '王五', phone: '13700137000', detail: '上海市浦东新区' },\n        });\n      orderId = res.body.data._id;\n    });\n\n    it('应成功支付待付款订单', async () => {\n      const res = await request(app)\n        .put(`/api/orders/${orderId}/pay`)\n        .set('Authorization', `Bearer ${token}`);\n\n      expect(res.status).toBe(200);\n      expect(res.body.data.status).toBe('paid');\n      expect(res.body.data).toHaveProperty('paidAt');\n    });\n  });\n\n  /** 取消订单 */\n  describe('PUT /api/orders/:id/cancel', () => {\n    let orderId: string;\n\n    beforeEach(async () => {\n      const res = await request(app)\n        .post('/api/orders')\n        .set('Authorization', `Bearer ${token}`)\n        .send({\n          items: [{ productId, quantity: 1 }],\n          shippingAddress: { name: '赵六', phone: '13600136000', detail: '杭州市西湖区' },\n        });\n      orderId = res.body.data._id;\n    });\n\n    it('应取消待付款订单', async () => {\n      const res = await request(app)\n        .put(`/api/orders/${orderId}/cancel`)\n        .set('Authorization', `Bearer ${token}`);\n\n      expect(res.status).toBe(200);\n      expect(res.body.data.status).toBe('cancelled');\n    });\n\n    it('已支付订单不能取消', async () => {\n      await request(app)\n        .put(`/api/orders/${orderId}/pay`)\n        .set('Authorization', `Bearer ${token}`);\n\n      const res = await request(app)\n        .put(`/api/orders/${orderId}/cancel`)\n        .set('Authorization', `Bearer ${token}`);\n\n      expect(res.status).toBe(400);\n    });\n  });\n\n  /** 管理员更新订单状态 */\n  describe('PUT /api/orders/:id/status', () => {\n    let orderId: string;\n\n    beforeEach(async () => {\n      // 创建并支付订单\n      const createRes = await request(app)\n        .post('/api/orders')\n        .set('Authorization', `Bearer ${token}`)\n        .send({\n          items: [{ productId, quantity: 1 }],\n          shippingAddress: { name: '测试', phone: '13500135000', detail: '广州市天河区' },\n        });\n      orderId = createRes.body.data._id;\n      await request(app)\n        .put(`/api/orders/${orderId}/pay`)\n        .set('Authorization', `Bearer ${token}`);\n    });\n\n    it('应更新订单状态为已发货', async () => {\n      const res = await request(app)\n        .put(`/api/orders/${orderId}/status`)\n        .set('Authorization', `Bearer ${adminToken}`)\n        .send({ status: 'shipped' });\n\n      expect(res.status).toBe(200);\n      expect(res.body.data.status).toBe('shipped');\n    });\n\n    it('无效状态应返回400', async () => {\n      const res = await request(app)\n        .put(`/api/orders/${orderId}/status`)\n        .set('Authorization', `Bearer ${adminToken}`)\n        .send({ status: 'invalid_status' });\n\n      expect(res.status).toBe(400);\n    });\n  });\n});","timestamp":1781396123,"tool_call_id":"call_3df6ab04939f42f1b78439f2","tool_name":"read_file","tool_calls":null}
{"type":"message","id":"3cb0428e-ef0c-4339-8d3c-d8d124997a48","role":"tool","content":"import request from 'supertest';\nimport app from '../index';\n\ndescribe('Auth API - 认证接口', () => {\n  /** 注册测试 */\n  describe('POST /api/auth/register', () => {\n    it('应成功注册新用户', async () => {\n      const res = await request(app)\n        .post('/api/auth/register')\n        .send({ email: 'test@test.com', password: 'password123', nickname: '测试用户' });\n\n      expect(res.status).toBe(201);\n      expect(res.body.success).toBe(true);\n      expect(res.body.data).toHaveProperty('token');\n      expect(res.body.data.user.email).toBe('test@test.com');\n      expect(res.body.data.user.nickname).toBe('测试用户');\n      expect(res.body.data.user).not.toHaveProperty('password');\n    });\n\n    it('重复邮箱应返回400', async () => {\n      await request(app)\n        .post('/api/auth/register')\n        .send({ email: 'dup@test.com', password: 'password123', nickname: '用户1' });\n\n      const res = await request(app)\n        .post('/api/auth/register')\n        .send({ email: 'dup@test.com', password: 'password456', nickname: '用户2' });\n\n      expect(res.status).toBe(400);\n      expect(res.body.success).toBe(false);\n      expect(res.body.message).toContain('已被注册');\n    });\n\n    it('无效邮箱应返回400', async () => {\n      const res = await request(app)\n        .post('/api/auth/register')\n        .send({ email: 'invalid-email', password: 'password123', nickname: '测试' });\n\n      expect(res.status).toBe(400);\n      expect(res.body.success).toBe(false);\n    });\n\n    it('密码长度不足6位应返回400', async () => {\n      const res = await request(app)\n        .post('/api/auth/register')\n        .send({ email: 'test@test.com', password: '123', nickname: '测试' });\n\n      expect(res.status).toBe(400);\n      expect(res.body.success).toBe(false);\n    });\n\n    it('缺少必填字段应返回400', async () => {\n      const res = await request(app)\n        .post('/api/auth/register')\n        .send({ email: 'test@test.com' });\n\n      expect(res.status).toBe(400);\n      expect(res.body.success).toBe(false);\n    });\n  });\n\n  /** 登录测试 */\n  describe('POST /api/auth/login', () => {\n    beforeEach(async () => {\n      await request(app)\n        .post('/api/auth/register')\n        .send({ email: 'login@test.com', password: 'password123', nickname: '登录测试' });\n    });\n\n    it('应使用正确凭证登录成功', async () => {\n      const res = await request(app)\n        .post('/api/auth/login')\n        .send({ email: 'login@test.com', password: 'password123' });\n\n      expect(res.status).toBe(200);\n      expect(res.body.success).toBe(true);\n      expect(res.body.data).toHaveProperty('token');\n      expect(res.body.data.user.email).toBe('login@test.com');\n    });\n\n    it('错误密码应返回401', async () => {\n      const res = await request(app)\n        .post('/api/auth/login')\n        .send({ email: 'login@test.com', password: 'wrongpassword' });\n\n      expect(res.status).toBe(401);\n      expect(res.body.success).toBe(false);\n    });\n\n    it('不存在的邮箱应返回401', async () => {\n      const res = await request(app)\n        .post('/api/auth/login')\n        .send({ email: 'nobody@test.com', password: 'password123' });\n\n      expect(res.status).toBe(401);\n      expect(res.body.success).toBe(false);\n    });\n  });\n\n  /** 获取用户信息测试 */\n  describe('GET /api/auth/profile', () => {\n    let token: string;\n\n    beforeEach(async () => {\n      const res = await request(app)\n        .post('/api/auth/register')\n        .send({ email: 'profile@test.com', password: 'password123', nickname: '个人信息测试' });\n      token = res.body.data.token;\n    });\n\n    it('应返回已认证用户的个人信息', async () => {\n      const res = await request(app)\n        .get('/api/auth/profile')\n        .set('Authorization', `Bearer ${token}`);\n\n      expect(res.status).toBe(200);\n      expect(res.body.success).toBe(true);\n      expect(res.body.data.email).toBe('profile@test.com');\n      expect(res.body.data.nickname).toBe('个人信息测试');\n    });\n\n    it('未提供Token应返回401', async () => {\n      const res = await request(app).get('/api/auth/profile');\n      expect(res.status).toBe(401);\n    });\n\n    it('无效Token应返回401', async () => {\n      const res = await request(app)\n        .get('/api/auth/profile')\n        .set('Authorization', 'Bearer invalid-token');\n      expect(res.status).toBe(401);\n    });\n  });\n\n  /** 更新用户信息测试 */\n  describe('PUT /api/auth/profile', () => {\n    let token: string;\n\n    beforeEach(async () => {\n      const res = await request(app)\n        .post('/api/auth/register')\n        .send({ email: 'update@test.com', password: 'password123', nickname: '更新测试' });\n      token = res.body.data.token;\n    });\n\n    it('应成功更新昵称', async () => {\n      const res = await request(app)\n        .put('/api/auth/profile')\n        .set('Authorization', `Bearer ${token}`)\n        .send({ nickname: '新昵称' });\n\n      expect(res.status).toBe(200);\n      expect(res.body.data.nickname).toBe('新昵称');\n    });\n\n    it('空昵称应返回400', async () => {\n      const res = await request(app)\n        .put('/api/auth/profile')\n        .set('Authorization', `Bearer ${token}`)\n        .send({ nickname: '' });\n\n      expect(res.status).toBe(400);\n    });\n  });\n});","timestamp":1781396123,"tool_call_id":"call_2a4e652b000446328a44c0ad","tool_name":"read_file","tool_calls":null}
