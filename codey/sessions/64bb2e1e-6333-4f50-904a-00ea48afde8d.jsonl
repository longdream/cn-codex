{"type":"message","id":"d4365a2d-5034-43d1-8def-2cc962c72bce","role":"tool","content":"import request from 'supertest';\nimport app from '../index';\n\nlet adminToken: string;\nlet userToken: string;\nlet productId: string;\n\nbeforeAll(async () => {\n  // 注册管理员并创建商品\n  const adminReg = await request(app)\n    .post('/api/auth/register')\n    .send({ email: 'cartadmin@test.com', password: 'admin123', nickname: 'CartAdmin' });\n  adminToken = adminReg.body.data.token;\n\n  const prodRes = await request(app)\n    .post('/api/products')\n    .set('Authorization', `Bearer ${adminToken}`)\n    .send({ name: '购物车测试商品', description: '测试用商品', price: 50, category: '电子产品', stock: 100 });\n  productId = prodRes.body.data.id;\n\n  // 注册普通用户\n  const userReg = await request(app)\n    .post('/api/auth/register')\n    .send({ email: 'cartuser@test.com', password: 'password123', nickname: '购物车测试' });\n  userToken = userReg.body.data.token;\n}, 15000);\n\ndescribe('Cart API - 购物车接口', () => {\n\n  /** 添加到购物车 */\n  describe('POST /api/cart', () => {\n    it('应添加商品到购物车', async () => {\n      const res = await request(app)\n        .post('/api/cart')\n        .set('Authorization', `Bearer ${userToken}`)\n        .send({ productId, quantity: 2 });\n\n      expect([200, 201]).toContain(res.status);\n      expect(res.body.success).toBe(true);\n    });\n\n    it('未认证不能添加购物车', async () => {\n      const res = await request(app)\n        .post('/api/cart')\n        .send({ productId, quantity: 1 });\n\n      expect(res.status).toBe(401);\n    });\n\n    it('数量为0应返回400', async () => {\n      const res = await request(app)\n        .post('/api/cart')\n        .set('Authorization', `Bearer ${userToken}`)\n        .send({ productId, quantity: 0 });\n\n      expect(res.status).toBe(400);\n    });\n\n    it('不存在的商品应返回404', async () => {\n      const res = await request(app)\n        .post('/api/cart')\n        .set('Authorization', `Bearer ${userToken}`)\n        .send({ productId: 'nonexistent-product-id', quantity: 1 });\n\n      expect(res.status).toBe(404);\n    });\n  });\n\n  /** 获取购物车 */\n  describe('GET /api/cart', () => {\n    it('应返回购物车列表', async () => {\n      await request(app)\n        .post('/api/cart')\n        .set('Authorization', `Bearer ${userToken}`)\n        .send({ productId, quantity: 1 });\n\n      const res = await request(app)\n        .get('/api/cart')\n        .set('Authorization', `Bearer ${userToken}`);\n\n      expect(res.status).toBe(200);\n      expect(res.body.success).toBe(true);\n      expect(Array.isArray(res.body.data)).toBe(true);\n    });\n  });\n\n  /** 更新购物车项 */\n  describe('PUT /api/cart/:id', () => {\n    let cartItemId: string;\n\n    beforeEach(async () => {\n      await request(app)\n        .post('/api/cart')\n        .set('Authorization', `Bearer ${userToken}`)\n        .send({ productId, quantity: 1 });\n\n      const cartRes = await request(app)\n        .get('/api/cart')\n        .set('Authorization', `Bearer ${userToken}`);\n\n      if (cartRes.body.data.length > 0) {\n        cartItemId = cartRes.body.data[0]._id;\n      }\n    });\n\n    it('应更新购物车项数量', async () => {\n      if (!cartItemId) return;\n      const res = await request(app)\n        .put(`/api/cart/${cartItemId}`)\n        .set('Authorization', `Bearer ${userToken}`)\n        .send({ quantity: 5 });\n\n      expect(res.status).toBe(200);\n      expect(res.body.data.quantity).toBe(5);\n    });\n  });\n\n  /** 删除购物车项 */\n  describe('DELETE /api/cart/:id', () => {\n    it('应删除购物车项', async () => {\n      await request(app)\n        .post('/api/cart')\n        .set('Authorization', `Bearer ${userToken}`)\n        .send({ productId, quantity: 1 });\n\n      const cartRes = await request(app)\n        .get('/api/cart')\n        .set('Authorization', `Bearer ${userToken}`);\n\n      if (cartRes.body.data.length > 0) {\n        const itemId = cartRes.body.data[0]._id;\n        const res = await request(app)\n          .delete(`/api/cart/${itemId}`)\n          .set('Authorization', `Bearer ${userToken}`);\n\n        expect(res.status).toBe(200);\n        expect(res.body.success).toBe(true);\n      }\n    });\n  });\n});","timestamp":1781396950,"tool_call_id":"call_9d64a647a922477aa6c6b969","tool_name":"read_file","tool_calls":null}
{"type":"message","id":"ab5eeb0f-7a19-4e08-a4a7-c4552e00bbd4","role":"tool","content":"import request from 'supertest';\nimport app from '../index';\n\nlet adminToken: string;\nlet userToken: string;\nlet productId: string;\nlet productId2: string;\n\nbeforeAll(async () => {\n  // 注册管理员\n  const adminReg = await request(app)\n    .post('/api/auth/register')\n    .send({ email: 'orderadmin@test.com', password: 'admin123', nickname: 'OrderAdmin' });\n  adminToken = adminReg.body.data.token;\n\n  // 创建商品\n  const prodRes = await request(app)\n    .post('/api/products')\n    .set('Authorization', `Bearer ${adminToken}`)\n    .send({ name: '订单测试商品', description: '测试', price: 100, category: '电子产品', stock: 50 });\n  productId = prodRes.body.data.id;\n\n  const prodRes2 = await request(app)\n    .post('/api/products')\n    .set('Authorization', `Bearer ${adminToken}`)\n    .send({ name: '订单测试商品2', description: '测试2', price: 200, category: '服装鞋帽', stock: 30 });\n  productId2 = prodRes2.body.data.id;\n\n  // 注册普通用户\n  const userReg = await request(app)\n    .post('/api/auth/register')\n    .send({ email: 'orderuser@test.com', password: 'password123', nickname: '订单测试' });\n  userToken = userReg.body.data.token;\n}, 15000);\n\ndescribe('Orders API - 订单接口', () => {\n\n  /** 创建订单 */\n  describe('POST /api/orders', () => {\n    it('应成功创建订单', async () => {\n      const res = await request(app)\n        .post('/api/orders')\n        .set('Authorization', `Bearer ${userToken}`)\n        .send({\n          items: [\n            { productId, quantity: 2 },\n            { productId: productId2, quantity: 1 },\n          ],\n          shippingAddress: {\n            name: '张三',\n            phone: '13800138000',\n            detail: '广东省深圳市南山区科技园',\n          },\n        });\n\n      expect(res.status).toBe(201);\n      expect(res.body.success).toBe(true);\n      expect(res.body.data).toHaveProperty('orderNo');\n      expect(res.body.data.totalAmount).toBe(400); // 100*2 + 200*1\n      expect(res.body.data.status).toBe('pending');\n      expect(res.body.data.items).toHaveLength(2);\n    });\n\n    it('未认证不能创建订单', async () => {\n      const res = await request(app)\n        .post('/api/orders')\n        .send({ items: [{ productId, quantity: 1 }], shippingAddress: { name: '测试', phone: '123', detail: '地址' } });\n\n      expect(res.status).toBe(401);\n    });\n\n    it('空商品列表应返回400', async () => {\n      const res = await request(app)\n        .post('/api/orders')\n        .set('Authorization', `Bearer ${userToken}`)\n        .send({ items: [], shippingAddress: { name: '测试', phone: '123', detail: '地址' } });\n\n      expect(res.status).toBe(400);\n    });\n\n    it('缺少收货地址应返回400', async () => {\n      const res = await request(app)\n        .post('/api/orders')\n        .set('Authorization', `Bearer ${userToken}`)\n        .send({ items: [{ productId, quantity: 1 }] });\n\n      expect(res.status).toBe(400);\n    });\n  });\n\n  /** 获取订单列表 */\n  describe('GET /api/orders', () => {\n    beforeEach(async () => {\n      await request(app)\n        .post('/api/orders')\n        .set('Authorization', `Bearer ${userToken}`)\n        .send({\n          items: [{ productId, quantity: 1 }],\n          shippingAddress: { name: '李四', phone: '13900139000', detail: '北京市朝阳区' },\n        });\n    });\n\n    it('应返回用户订单列表', async () => {\n      const res = await request(app)\n        .get('/api/orders')\n        .set('Authorization', `Bearer ${userToken}`);\n\n      expect(res.status).toBe(200);\n      expect(res.body.success).toBe(true);\n      expect(Array.isArray(res.body.data)).toBe(true);\n      expect(res.body.data.length).toBeGreaterThanOrEqual(1);\n    });\n  });\n\n  /** 模拟支付 */\n  describe('PUT /api/orders/:id/pay', () => {\n    let orderId: string;\n\n    beforeEach(async () => {\n      const res = await request(app)\n        .post('/api/orders')\n        .set('Authorization', `Bearer ${userToken}`)\n        .send({\n          items: [{ productId, quantity: 1 }],\n          shippingAddress: { name: '王五', phone: '13700137000', detail: '上海市浦东新区' },\n        });\n      orderId = res.body.data._id;\n    });\n\n    it('应成功支付待付款订单', async () => {\n      const res = await request(app)\n        .put(`/api/orders/${orderId}/pay`)\n        .set('Authorization', `Bearer ${userToken}`);\n\n      expect(res.status).toBe(200);\n      expect(res.body.data.status).toBe('paid');\n      expect(res.body.data).toHaveProperty('paidAt');\n    });\n  });\n\n  /** 取消订单 */\n  describe('PUT /api/orders/:id/cancel', () => {\n    let orderId: string;\n\n    beforeEach(async () => {\n      const res = await request(app)\n        .post('/api/orders')\n        .set('Authorization', `Bearer ${userToken}`)\n        .send({\n          items: [{ productId, quantity: 1 }],\n          shippingAddress: { name: '赵六', phone: '13600136000', detail: '杭州市西湖区' },\n        });\n      orderId = res.body.data._id;\n    });\n\n    it('应取消待付款订单', async () => {\n      const res = await request(app)\n        .put(`/api/orders/${orderId}/cancel`)\n        .set('Authorization', `Bearer ${userToken}`);\n\n      expect(res.status).toBe(200);\n      expect(res.body.data.status).toBe('cancelled');\n    });\n\n    it('已支付订单不能取消', async () => {\n      await request(app)\n        .put(`/api/orders/${orderId}/pay`)\n        .set('Authorization', `Bearer ${userToken}`);\n\n      const res = await request(app)\n        .put(`/api/orders/${orderId}/cancel`)\n        .set('Authorization', `Bearer ${userToken}`);\n\n      expect(res.status).toBe(400);\n    });\n  });\n\n  /** 管理员更新订单状态 */\n  describe('PUT /api/orders/:id/status', () => {\n    let orderId: string;\n\n    beforeEach(async () => {\n      const createRes = await request(app)\n        .post('/api/orders')\n        .set('Authorization', `Bearer ${userToken}`)\n        .send({\n          items: [{ productId, quantity: 1 }],\n          shippingAddress: { name: '测试', phone: '13500135000', detail: '广州市天河区' },\n        });\n      orderId = createRes.body.data._id;\n      await request(app)\n        .put(`/api/orders/${orderId}/pay`)\n        .set('Authorization', `Bearer ${userToken}`);\n    });\n\n    it('应更新订单状态为已发货', async () => {\n      const res = await request(app)\n        .put(`/api/orders/${orderId}/status`)\n        .set('Authorization', `Bearer ${adminToken}`)\n        .send({ status: 'shipped' });\n\n      expect(res.status).toBe(200);\n      expect(res.body.data.status).toBe('shipped');\n    });\n\n    it('无效状态应返回400', async () => {\n      const res = await request(app)\n        .put(`/api/orders/${orderId}/status`)\n        .set('Authorization', `Bearer ${adminToken}`)\n        .send({ status: 'invalid_status' });\n\n      expect(res.status).toBe(400);\n    });\n  });\n});","timestamp":1781396950,"tool_call_id":"call_0b06eff92cf54bbb98988c62","tool_name":"read_file","tool_calls":null}
{"type":"message","id":"6cad76dd-f7ef-451d-9e05-21917a1ea0b7","role":"tool","content":"{\n  \"name\": \"ecommerce-client\",\n  \"version\": \"1.0.0\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"build\": \"tsc -b && vite build\",\n    \"preview\": \"vite preview\",\n    \"test\": \"vitest run\",\n    \"test:watch\": \"vitest\",\n    \"test:coverage\": \"vitest run --coverage\"\n  },\n  \"dependencies\": {\n    \"@ant-design/icons\": \"^5.2.6\",\n    \"antd\": \"^5.12.5\",\n    \"axios\": \"^1.6.2\",\n    \"dayjs\": \"^1.11.10\",\n    \"react\": \"^18.2.0\",\n    \"react-dom\": \"^18.2.0\",\n    \"react-router-dom\": \"^6.21.1\",\n    \"zustand\": \"^4.4.7\"\n  },\n  \"devDependencies\": {\n    \"@testing-library/jest-dom\": \"^6.1.5\",\n    \"@testing-library/react\": \"^14.1.2\",\n    \"@testing-library/user-event\": \"^14.5.2\",\n    \"@types/react\": \"^18.2.45\",\n    \"@types/react-dom\": \"^18.2.18\",\n    \"@vitejs/plugin-react\": \"^4.2.1\",\n    \"jsdom\": \"^23.0.1\",\n    \"typescript\": \"^5.3.3\",\n    \"vite\": \"^5.0.10\",\n    \"vitest\": \"^1.1.0\"\n  }\n}","timestamp":1781396950,"tool_call_id":"call_504793ed0247469d9b73603b","tool_name":"read_file","tool_calls":null}
