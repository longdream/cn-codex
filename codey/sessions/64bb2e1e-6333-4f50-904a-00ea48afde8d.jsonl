{"type":"message","id":"244a3549-05b4-4915-9c46-b3036366ef72","role":"tool","content":"import { Router, Request, Response } from 'express';\nimport { body, validationResult } from 'express-validator';\nimport { getDB } from '../config/database';\nimport { authenticate, authorizeAdmin } from '../middleware/auth';\nimport { generateId } from '../utils/order';\nimport { ProductRow, ProductData, rowToProduct } from '../models';\n\nconst router = Router();\n\nconst handleValidationErrors = (req: Request, res: Response): boolean => {\n  const errors = validationResult(req);\n  if (!errors.isEmpty()) {\n    res.status(400).json({\n      success: false,\n      message: '参数校验失败',\n      errors: errors.array().map((e) => e.msg),\n    });\n    return true;\n  }\n  return false;\n};\n\n/**\n * GET /api/products - 获取商品列表（公开）\n */\nrouter.get('/', (req: Request, res: Response) => {\n  try {\n    const db = getDB();\n    const page = Math.max(1, parseInt(req.query.page as string) || 1);\n    const limit = Math.min(50, Math.max(1, parseInt(req.query.limit as string) || 10));\n    const skip = (page - 1) * limit;\n    const category = req.query.category as string;\n    const search = req.query.search as string;\n    const sort = req.query.sort as string;\n    const minPrice = parseFloat(req.query.minPrice as string);\n    const maxPrice = parseFloat(req.query.maxPrice as string);\n\n    let whereClauses: string[] = [\"status = 'active'\"];\n    let params: any[] = [];\n\n    if (category) {\n      whereClauses.push('category = ?');\n      params.push(category);\n    }\n    if (!isNaN(minPrice)) {\n      whereClauses.push('price >= ?');\n      params.push(minPrice);\n    }\n    if (!isNaN(maxPrice)) {\n      whereClauses.push('price <= ?');\n      params.push(maxPrice);\n    }\n    if (search) {\n      whereClauses.push(\"(name LIKE ? OR description LIKE ?)\");\n      params.push(`%${search}%`, `%${search}%`);\n    }\n\n    const whereSQL = whereClauses.length > 0 ? 'WHERE ' + whereClauses.join(' AND ') : '';\n\n    let orderSQL = 'ORDER BY created_at DESC';\n    if (sort === 'price') orderSQL = 'ORDER BY price ASC';\n    else if (sort === '-price') orderSQL = 'ORDER BY price DESC';\n    else if (sort === 'sales') orderSQL = 'ORDER BY sales DESC';\n    else if (sort === 'createdAt') orderSQL = 'ORDER BY created_at DESC';\n\n    const countRow = db.prepare(`SELECT COUNT(*) as total FROM products ${whereSQL}`).get(...params) as any;\n    const total = countRow.total;\n\n    const rows = db.prepare(\n      `SELECT * FROM products ${whereSQL} ${orderSQL} LIMIT ? OFFSET ?`\n    ).all(...params, limit, skip) as ProductRow[];\n\n    res.json({\n      success: true,\n      data: rows.map(rowToProduct),\n      pagination: { page, limit, total, pages: Math.ceil(total / limit) },\n    });\n  } catch (error: any) {\n    res.status(500).json({ success: false, message: '获取商品列表失败', error: error.message });\n  }\n});\n\n/**\n * GET /api/products/categories - 获取所有分类（公开）\n */\nrouter.get('/categories', (_req: Request, res: Response) => {\n  try {\n    const db = getDB();\n    const rows = db.prepare(\n      \"SELECT DISTINCT category FROM products WHERE status = 'active' ORDER BY category\"\n    ).all() as { category: string }[];\n    res.json({ success: true, data: rows.map(r => r.category) });\n  } catch {\n    res.status(500).json({ success: false, message: '获取分类失败' });\n  }\n});\n\n/**\n * GET /api/products/:id - 获取商品详情（公开）\n */\nrouter.get('/:id', (req: Request, res: Response) => {\n  try {\n    const db = getDB();\n    const row = db.prepare(\n      \"SELECT * FROM products WHERE id = ? AND status = 'active'\"\n    ).get(req.params.id) as ProductRow | undefined;\n\n    if (!row) {\n      res.status(404).json({ success: false, message: '商品不存在' });\n      return;\n    }\n\n    res.json({ success: true, data: rowToProduct(row) });\n  } catch {\n    res.status(500).json({ success: false, message: '获取商品详情失败' });\n  }\n});\n\n/**\n * POST /api/products - 创建商品（管理员）\n */\nrouter.post(\n  '/',\n  authenticate,\n  authorizeAdmin,\n  [\n    body('name').notEmpty().withMessage('商品名称不能为空'),\n    body('description').notEmpty().withMessage('商品描述不能为空'),\n    body('price').isFloat({ min: 0 }).withMessage('价格必须大于等于0'),\n    body('category').notEmpty().withMessage('分类不能为空'),\n    body('stock').isInt({ min: 0 }).withMessage('库存必须大于等于0'),\n  ],\n  (req: Request, res: Response) => {\n    if (handleValidationErrors(req, res)) return;\n\n    try {\n      const db = getDB();\n      const id = generateId();\n      const { name, description, price, originalPrice, images, category, stock, rating, status } = req.body;\n\n      db.prepare(`\n        INSERT INTO products (id, name, description, price, original_price, images, category, stock, rating, status)\n        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)\n      `).run(\n        id, name, description, price, originalPrice || 0,\n        JSON.stringify(images || []), category, stock || 0, rating || 5.0, status || 'active'\n      );\n\n      const row = db.prepare('SELECT * FROM products WHERE id = ?').get(id) as ProductRow;\n      res.status(201).json({ success: true, data: rowToProduct(row) });\n    } catch (error: any) {\n      res.status(500).json({ success: false, message: '创建商品失败', error: error.message });\n    }\n  }\n);\n\n/**\n * PUT /api/products/:id - 更新商品（管理员）\n */\nrouter.put(\n  '/:id',\n  authenticate,\n  authorizeAdmin,\n  (req: Request, res: Response) => {\n    try {\n      const db = getDB();\n      const existing = db.prepare('SELECT * FROM products WHERE id = ?').get(req.params.id);\n      if (!existing) {\n        res.status(404).json({ success: false, message: '商品不存在' });\n        return;\n      }\n\n      const fields: string[] = [];\n      const params: any[] = [];\n      const allowed = ['name', 'description', 'price', 'original_price', 'images', 'category', 'stock', 'rating', 'status'];\n\n      for (const key of allowed) {\n        if (req.body[key] !== undefined) {\n          const dbKey = key === 'originalPrice' ? 'original_price' : key;\n          const val = key === 'images' ? JSON.stringify(req.body[key]) : req.body[key];\n          fields.push(`${key === 'originalPrice' ? 'original_price' : key} = ?`);\n          params.push(val);\n        }\n      }\n\n      if (fields.length > 0) {\n        params.push(req.params.id);\n        db.prepare(`UPDATE products SET ${fields.join(', ')}, updated_at = datetime('now') WHERE id = ?`).run(...params);\n      }\n\n      const row = db.prepare('SELECT * FROM products WHERE id = ?').get(req.params.id) as ProductRow;\n      res.json({ success: true, data: rowToProduct(row) });\n    } catch (error: any) {\n      res.status(500).json({ success: false, message: '更新商品失败' });\n    }\n  }\n);\n\n/**\n * DELETE /api/products/:id - 删除商品（管理员）\n */\nrouter.delete(\n  '/:id',\n  authenticate,\n  authorizeAdmin,\n  (req: Request, res: Response) => {\n    try {\n      const db = getDB();\n      const existing = db.prepare('SELECT * FROM products WHERE id = ?').get(req.params.id);\n      if (!existing) {\n        res.status(404).json({ success: false, message: '商品不存在' });\n        return;\n      }\n      db.prepare('DELETE FROM products WHERE id = ?').run(req.params.id);\n      res.json({ success: true, message: '商品已删除' });\n    } catch {\n      res.status(500).json({ success: false, message: '删除商品失败' });\n    }\n  }\n);\n\nexport default router;","timestamp":1781396939,"tool_call_id":"call_49a9316959064eb998f0ed2f","tool_name":"read_file","tool_calls":null}
{"type":"message","id":"c8784688-d65b-48c8-85e1-4f57d0ea0c21","role":"tool","content":"import { Router, Request, Response } from 'express';\nimport { body, validationResult } from 'express-validator';\nimport { getDB } from '../config/database';\nimport { authenticate } from '../middleware/auth';\nimport { generateId } from '../utils/order';\nimport { CartItemRow, ProductRow, ProductData, rowToProduct } from '../models';\n\nconst router = Router();\n\n/** 使用认证中间件 - 所有购物车接口都需要登录 */\nrouter.use(authenticate);\n\n/** 统一校验处理 */\nconst handleValidationErrors = (req: Request, res: Response): boolean => {\n  const errors = validationResult(req);\n  if (!errors.isEmpty()) {\n    res.status(400).json({\n      success: false,\n      message: '参数校验失败',\n      errors: errors.array().map((e) => e.msg),\n    });\n    return true;\n  }\n  return false;\n};\n\n/** 将购物车行转换为前端格式 */\nfunction rowToCartData(row: CartItemRow, product: ProductRow): any {\n  return {\n    _id: row.id,\n    userId: row.user_id,\n    productId: rowToProduct(product),\n    quantity: row.quantity,\n    createdAt: row.created_at,\n    updatedAt: row.updated_at,\n  };\n}\n\n/**\n * GET /api/cart - 获取购物车列表\n */\nrouter.get('/', (req: Request, res: Response) => {\n  try {\n    const db = getDB();\n    const rows = db.prepare(\n      'SELECT c.*, p.* FROM cart_items c JOIN products p ON c.product_id = p.id WHERE c.user_id = ? ORDER BY c.created_at DESC'\n    ).all(req.userId) as any[];\n\n    const validItems = rows\n      .filter(r => r.status === 'active')\n      .map(r => {\n        const cartRow: CartItemRow = {\n          id: r.id,\n          user_id: r.user_id,\n          product_id: r.product_id,\n          quantity: r.quantity,\n          created_at: r.created_at,\n          updated_at: r.updated_at,\n        };\n        const productRow: ProductRow = {\n          id: r.id_product || r.product_id,\n          name: r.name,\n          description: r.description,\n          price: r.price,\n          original_price: r.original_price,\n          images: r.images,\n          category: r.category,\n          stock: r.stock,\n          sales: r.sales,\n          rating: r.rating,\n          status: r.status,\n          created_at: r.p_created_at || r.created_at,\n          updated_at: r.p_updated_at || r.updated_at,\n        };\n        return rowToCartData(cartRow, productRow);\n      });\n\n    res.json({ success: true, data: validItems });\n  } catch (error: any) {\n    res.status(500).json({ success: false, message: '获取购物车失败', error: error.message });\n  }\n});\n\n/**\n * POST /api/cart - 添加商品到购物车\n */\nrouter.post(\n  '/',\n  [\n    body('productId').notEmpty().withMessage('商品ID不能为空'),\n    body('quantity').isInt({ min: 1 }).withMessage('数量必须大于0'),\n  ],\n  (req: Request, res: Response) => {\n    if (handleValidationErrors(req, res)) return;\n\n    try {\n      const db = getDB();\n      const { productId, quantity } = req.body;\n\n      // 验证商品存在且有效\n      const product = db.prepare(\n        \"SELECT * FROM products WHERE id = ? AND status = 'active'\"\n      ).get(productId) as ProductRow | undefined;\n\n      if (!product) {\n        res.status(404).json({ success: false, message: '商品不存在或已下架' });\n        return;\n      }\n\n      if (product.stock < quantity) {\n        res.status(400).json({\n          success: false,\n          message: `商品库存不足，当前库存: ${product.stock}`,\n        });\n        return;\n      }\n\n      // 检查是否已在购物车中\n      const existingItem = db.prepare(\n        'SELECT * FROM cart_items WHERE user_id = ? AND product_id = ?'\n      ).get(req.userId, productId) as CartItemRow | undefined;\n\n      if (existingItem) {\n        // 更新数量\n        const newQuantity = existingItem.quantity + quantity;\n        if (newQuantity > product.stock) {\n          res.status(400).json({\n            success: false,\n            message: `购物车中该商品数量已达上限，最大可购买 ${product.stock} 件`,\n          });\n          return;\n        }\n\n        db.prepare(\n          \"UPDATE cart_items SET quantity = ?, updated_at = datetime('now') WHERE id = ?\"\n        ).run(newQuantity, existingItem.id);\n\n        const updated = db.prepare(\n          'SELECT * FROM cart_items WHERE id = ?'\n        ).get(existingItem.id) as CartItemRow;\n\n        res.json({\n          success: true,\n          data: rowToCartData(updated, product),\n          message: '购物车已更新',\n        });\n      } else {\n        // 新建购物车项\n        const id = generateId();\n        db.prepare(\n          'INSERT INTO cart_items (id, user_id, product_id, quantity) VALUES (?, ?, ?, ?)'\n        ).run(id, req.userId, productId, quantity);\n\n        const newItem = db.prepare('SELECT * FROM cart_items WHERE id = ?').get(id) as CartItemRow;\n\n        res.status(201).json({\n          success: true,\n          data: rowToCartData(newItem, product),\n          message: '已添加到购物车',\n        });\n      }\n    } catch (error: any) {\n      res.status(500).json({ success: false, message: '添加购物车失败', error: error.message });\n    }\n  }\n);\n\n/**\n * PUT /api/cart/:id - 修改购物车项数量\n */\nrouter.put(\n  '/:id',\n  [body('quantity').isInt({ min: 1 }).withMessage('数量必须大于0')],\n  (req: Request, res: Response) => {\n    if (handleValidationErrors(req, res)) return;\n\n    try {\n      const db = getDB();\n      const { quantity } = req.body;\n\n      const cartItem = db.prepare(\n        'SELECT * FROM cart_items WHERE id = ? AND user_id = ?'\n      ).get(req.params.id, req.userId) as CartItemRow | undefined;\n\n      if (!cartItem) {\n        res.status(404).json({ success: false, message: '购物车项不存在' });\n        return;\n      }\n\n      // 验证库存\n      const product = db.prepare('SELECT * FROM products WHERE id = ?').get(cartItem.product_id) as ProductRow | undefined;\n      if (product && quantity > product.stock) {\n        res.status(400).json({\n          success: false,\n          message: `库存不足，当前库存: ${product.stock}`,\n        });\n        return;\n      }\n\n      db.prepare(\n        \"UPDATE cart_items SET quantity = ?, updated_at = datetime('now') WHERE id = ?\"\n      ).run(quantity, req.params.id);\n\n      const updated = db.prepare('SELECT * FROM cart_items WHERE id = ?').get(req.params.id) as CartItemRow;\n      const prod = db.prepare('SELECT * FROM products WHERE id = ?').get(cartItem.product_id) as ProductRow;\n\n      res.json({ success: true, data: rowToCartData(updated, prod) });\n    } catch (error: any) {\n      res.status(500).json({ success: false, message: '更新购物车失败' });\n    }\n  }\n);\n\n/**\n * DELETE /api/cart/:id - 删除购物车项\n */\nrouter.delete('/:id', (req: Request, res: Response) => {\n  try {\n    const db = getDB();\n    const cartItem = db.prepare(\n      'SELECT * FROM cart_items WHERE id = ? AND user_id = ?'\n    ).get(req.params.id, req.userId);\n\n    if (!cartItem) {\n      res.status(404).json({ success: false, message: '购物车项不存在' });\n      return;\n    }\n\n    db.prepare('DELETE FROM cart_items WHERE id = ?').run(req.params.id);\n\n    res.json({ success: true, message: '已从购物车移除' });\n  } catch (error: any) {\n    res.status(500).json({ success: false, message: '删除购物车项失败' });\n  }\n});\n\n/**\n * DELETE /api/cart - 清空购物车\n */\nrouter.delete('/', (req: Request, res: Response) => {\n  try {\n    const db = getDB();\n    db.prepare('DELETE FROM cart_items WHERE user_id = ?').run(req.userId);\n    res.json({ success: true, message: '购物车已清空' });\n  } catch (error: any) {\n    res.status(500).json({ success: false, message: '清空购物车失败' });\n  }\n});\n\nexport default router;","timestamp":1781396939,"tool_call_id":"call_e94534c4367d42fbaa8696c1","tool_name":"read_file","tool_calls":null}
{"type":"message","id":"ee99b297-21b2-4640-9ebd-59b8b060d43d","role":"tool","content":"import { Router, Request, Response } from 'express';\nimport { body, validationResult } from 'express-validator';\nimport { getDB } from '../config/database';\nimport { authenticate, authorizeAdmin } from '../middleware/auth';\nimport { generateId, generateOrderNo } from '../utils/order';\nimport {\n  OrderRow,\n  OrderItemRow,\n  ProductRow,\n  CartItemRow,\n  OrderItemData,\n  OrderData,\n  rowToOrder,\n} from '../models';\n\nconst router = Router();\n\nrouter.use(authenticate);\n\n/** 统一校验处理 */\nconst handleValidationErrors = (req: Request, res: Response): boolean => {\n  const errors = validationResult(req);\n  if (!errors.isEmpty()) {\n    res.status(400).json({\n      success: false,\n      message: '参数校验失败',\n      errors: errors.array().map((e) => e.msg),\n    });\n    return true;\n  }\n  return false;\n};\n\n/** 加载订单的 items */\nfunction loadOrderItems(orderId: string): OrderItemData[] {\n  const db = getDB();\n  const itemRows = db.prepare(\n    'SELECT * FROM order_items WHERE order_id = ?'\n  ).all(orderId) as OrderItemRow[];\n\n  return itemRows.map(item => ({\n    productId: item.product_id,\n    productName: item.product_name,\n    price: item.price,\n    quantity: item.quantity,\n    image: item.image,\n  }));\n}\n\n/** 加载单个订单（含 items） */\nfunction loadFullOrder(orderId: string, userId?: string): OrderData | null {\n  const db = getDB();\n  let order: OrderRow | undefined;\n\n  if (userId) {\n    order = db.prepare(\n      'SELECT * FROM orders WHERE id = ? AND user_id = ?'\n    ).get(orderId, userId) as OrderRow | undefined;\n  } else {\n    order = db.prepare('SELECT * FROM orders WHERE id = ?').get(orderId) as OrderRow | undefined;\n  }\n\n  if (!order) return null;\n\n  const items = loadOrderItems(order.id);\n  return rowToOrder(order, items);\n}\n\n/**\n * POST /api/orders - 创建订单（从购物车）\n */\nrouter.post(\n  '/',\n  [\n    body('items').isArray({ min: 1 }).withMessage('订单至少包含一个商品'),\n    body('items.*.productId').notEmpty().withMessage('商品ID不能为空'),\n    body('items.*.quantity').isInt({ min: 1 }).withMessage('数量必须大于0'),\n    body('shippingAddress').notEmpty().withMessage('收货地址不能为空'),\n    body('shippingAddress.name').notEmpty().withMessage('收货人姓名不能为空'),\n    body('shippingAddress.phone').notEmpty().withMessage('收货人电话不能为空'),\n    body('shippingAddress.detail').notEmpty().withMessage('收货地址详情不能为空'),\n  ],\n  (req: Request, res: Response) => {\n    if (handleValidationErrors(req, res)) return;\n\n    const db = getDB();\n\n    // 使用事务确保原子性\n    const createOrder = db.transaction(() => {\n      const { items, shippingAddress } = req.body;\n\n      const orderItems: OrderItemData[] = [];\n      let totalAmount = 0;\n\n      for (const item of items) {\n        const product = db.prepare(\n          \"SELECT * FROM products WHERE id = ? AND status = 'active'\"\n        ).get(item.productId) as ProductRow | undefined;\n\n        if (!product) {\n          throw new Error(`商品 ${item.productId} 不存在或已下架`);\n        }\n\n        if (product.stock < item.quantity) {\n          throw new Error(`商品 \"${product.name}\" 库存不足，当前库存: ${product.stock}`);\n        }\n\n        orderItems.push({\n          productId: product.id,\n          productName: product.name,\n          price: product.price,\n          quantity: item.quantity,\n          image: JSON.parse(product.images || '[]')[0] || '',\n        });\n\n        totalAmount += product.price * item.quantity;\n      }\n\n      // 生成订单\n      const orderId = generateId();\n      const orderNo = generateOrderNo();\n\n      db.prepare(`\n        INSERT INTO orders (id, order_no, user_id, total_amount, status, shipping_name, shipping_phone, shipping_detail)\n        VALUES (?, ?, ?, ?, 'pending', ?, ?, ?)\n      `).run(orderId, orderNo, req.userId, totalAmount, shippingAddress.name, shippingAddress.phone, shippingAddress.detail);\n\n      // 插入订单项 + 扣减库存 + 增加销量\n      const insertItem = db.prepare(`\n        INSERT INTO order_items (id, order_id, product_id, product_name, price, quantity, image)\n        VALUES (?, ?, ?, ?, ?, ?, ?)\n      `);\n\n      const updateStock = db.prepare(\n        'UPDATE products SET stock = stock - ?, sales = sales + ?, updated_at = datetime(\\'now\\') WHERE id = ? AND stock >= ?'\n      );\n\n      for (const oi of orderItems) {\n        insertItem.run(generateId(), orderId, oi.productId, oi.productName, oi.price, oi.quantity, oi.image);\n\n        const result = updateStock.run(oi.quantity, oi.quantity, oi.productId, oi.quantity);\n        if (result.changes === 0) {\n          throw new Error(`商品 \"${oi.productName}\" 库存不足`);\n        }\n      }\n\n      // 清除购物车中已下单的商品\n      const productIds = items.map((item: any) => item.productId);\n      const placeholders = productIds.map(() => '?').join(',');\n      db.prepare(`DELETE FROM cart_items WHERE user_id = ? AND product_id IN (${placeholders})`).run(req.userId, ...productIds);\n\n      return loadFullOrder(orderId);\n    });\n\n    try {\n      const order = createOrder();\n      res.status(201).json({ success: true, data: order });\n    } catch (error: any) {\n      res.status(500).json({ success: false, message: error.message || '创建订单失败' });\n    }\n  }\n);\n\n/**\n * GET /api/orders - 获取订单列表\n */\nrouter.get('/', (req: Request, res: Response) => {\n  try {\n    const db = getDB();\n    const page = Math.max(1, parseInt(req.query.page as string) || 1);\n    const limit = Math.min(50, Math.max(1, parseInt(req.query.limit as string) || 10));\n    const skip = (page - 1) * limit;\n    const status = req.query.status as string;\n\n    let whereClauses = ['user_id = ?'];\n    let params: any[] = [req.userId];\n\n    if (status) {\n      whereClauses.push('status = ?');\n      params.push(status);\n    }\n\n    const whereSQL = 'WHERE ' + whereClauses.join(' AND ');\n\n    const countRow = db.prepare(`SELECT COUNT(*) as total FROM orders ${whereSQL}`).get(...params) as any;\n    const total = countRow.total;\n\n    const orderRows = db.prepare(\n      `SELECT * FROM orders ${whereSQL} ORDER BY created_at DESC LIMIT ? OFFSET ?`\n    ).all(...params, limit, skip) as OrderRow[];\n\n    const data = orderRows.map(order => {\n      const items = loadOrderItems(order.id);\n      return rowToOrder(order, items);\n    });\n\n    res.json({\n      success: true,\n      data,\n      pagination: { page, limit, total, pages: Math.ceil(total / limit) },\n    });\n  } catch (error: any) {\n    res.status(500).json({ success: false, message: '获取订单列表失败', error: error.message });\n  }\n});\n\n/**\n * GET /api/orders/all - 获取所有订单（管理员）\n */\nrouter.get('/all', authorizeAdmin, (req: Request, res: Response) => {\n  try {\n    const db = getDB();\n    const page = Math.max(1, parseInt(req.query.page as string) || 1);\n    const limit = Math.min(50, Math.max(1, parseInt(req.query.limit as string) || 10));\n    const skip = (page - 1) * limit;\n    const status = req.query.status as string;\n\n    let whereClauses: string[] = [];\n    let params: any[] = [];\n\n    if (status) {\n      whereClauses.push('status = ?');\n      params.push(status);\n    }\n\n    const whereSQL = whereClauses.length > 0 ? 'WHERE ' + whereClauses.join(' AND ') : '';\n\n    const countRow = db.prepare(`SELECT COUNT(*) as total FROM orders ${whereSQL}`).get(...params) as any;\n    const total = countRow.total;\n\n    const orderRows = db.prepare(\n      `SELECT o.*, u.email as user_email, u.nickname as user_nickname\n       FROM orders o LEFT JOIN users u ON o.user_id = u.id ${whereSQL}\n       ORDER BY o.created_at DESC LIMIT ? OFFSET ?`\n    ).all(...params, limit, skip) as any[];\n\n    const data = orderRows.map(order => {\n      const items = loadOrderItems(order.id);\n      return {\n        ...rowToOrder(order, items),\n        user: {\n          email: order.user_email,\n          nickname: order.user_nickname,\n        },\n      };\n    });\n\n    res.json({\n      success: true,\n      data,\n      pagination: { page, limit, total, pages: Math.ceil(total / limit) },\n    });\n  } catch (error: any) {\n    res.status(500).json({ success: false, message: '获取全部订单失败', error: error.message });\n  }\n});\n\n/**\n * GET /api/orders/:id - 获取订单详情\n */\nrouter.get('/:id', (req: Request, res: Response) => {\n  try {\n    const order = loadFullOrder(req.params.id, req.userId);\n    if (!order) {\n      res.status(404).json({ success: false, message: '订单不存在' });\n      return;\n    }\n    res.json({ success: true, data: order });\n  } catch (error: any) {\n    res.status(500).json({ success: false, message: '获取订单详情失败' });\n  }\n});\n\n/**\n * PUT /api/orders/:id/cancel - 取消订单\n */\nrouter.put('/:id/cancel', (req: Request, res: Response) => {\n  const db = getDB();\n\n  const cancelOrder = db.transaction(() => {\n    const order = db.prepare(\n      'SELECT * FROM orders WHERE id = ? AND user_id = ?'\n    ).get(req.params.id, req.userId) as OrderRow | undefined;\n\n    if (!order) {\n      throw { status: 404, message: '订单不存在' };\n    }\n\n    if (order.status !== 'pending') {\n      throw { status: 400, message: '只能取消待付款订单' };\n    }\n\n    // 恢复库存\n    const items = db.prepare('SELECT * FROM order_items WHERE order_id = ?').all(order.id) as OrderItemRow[];\n    const restoreStock = db.prepare(\n      'UPDATE products SET stock = stock + ?, sales = MAX(0, sales - ?), updated_at = datetime(\\'now\\') WHERE id = ?'\n    );\n    for (const item of items) {\n      restoreStock.run(item.quantity, item.quantity, item.product_id);\n    }\n\n    db.prepare(\n      \"UPDATE orders SET status = 'cancelled', updated_at = datetime('now') WHERE id = ?\"\n    ).run(req.params.id);\n\n    return loadFullOrder(req.params.id);\n  });\n\n  try {\n    const order = cancelOrder();\n    res.json({ success: true, data: order });\n  } catch (error: any) {\n    const status = error.status || 500;\n    res.status(status).json({ success: false, message: error.message || '取消订单失败' });\n  }\n});\n\n/**\n * PUT /api/orders/:id/pay - 模拟支付\n */\nrouter.put('/:id/pay', (req: Request, res: Response) => {\n  try {\n    const db = getDB();\n    const order = db.prepare(\n      'SELECT * FROM orders WHERE id = ? AND user_id = ?'\n    ).get(req.params.id, req.userId) as OrderRow | undefined;\n\n    if (!order) {\n      res.status(404).json({ success: false, message: '订单不存在' });\n      return;\n    }\n\n    if (order.status !== 'pending') {\n      res.status(400).json({ success: false, message: '订单状态不允许支付' });\n      return;\n    }\n\n    db.prepare(\n      \"UPDATE orders SET status = 'paid', paid_at = datetime('now'), updated_at = datetime('now') WHERE id = ?\"\n    ).run(req.params.id);\n\n    const updated = loadFullOrder(req.params.id);\n    res.json({ success: true, data: updated });\n  } catch (error: any) {\n    res.status(500).json({ success: false, message: '支付失败' });\n  }\n});\n\n/**\n * PUT /api/orders/:id/status - 更新订单状态（管理员）\n */\nrouter.put('/:id/status', authorizeAdmin, (req: Request, res: Response) => {\n  try {\n    const db = getDB();\n    const { status } = req.body;\n    const validStatuses = ['shipped', 'delivered'];\n\n    if (!validStatuses.includes(status)) {\n      res.status(400).json({ success: false, message: '无效的订单状态' });\n      return;\n    }\n\n    const order = db.prepare('SELECT * FROM orders WHERE id = ?').get(req.params.id) as OrderRow | undefined;\n    if (!order) {\n      res.status(404).json({ success: false, message: '订单不存在' });\n      return;\n    }\n\n    db.prepare(\n      \"UPDATE orders SET status = ?, updated_at = datetime('now') WHERE id = ?\"\n    ).run(status, req.params.id);\n\n    const updated = loadFullOrder(req.params.id);\n    res.json({ success: true, data: updated });\n  } catch (error: any) {\n    res.status(500).json({ success: false, message: '更新订单状态失败' });\n  }\n});\n\nexport default router;","timestamp":1781396939,"tool_call_id":"call_f9cb6bb5aa8844eb932f21cf","tool_name":"read_file","tool_calls":null}
{"type":"message","id":"274873d5-088c-4d88-8a92-ffb7108bf5e4","role":"tool","content":"import express from 'express';\nimport cors from 'cors';\nimport { config } from './config';\nimport { initDB } from './config/database';\nimport authRoutes from './routes/auth';\nimport productRoutes from './routes/products';\nimport cartRoutes from './routes/cart';\nimport orderRoutes from './routes/orders';\n\nconst app = express();\n\n/** 中间件 */\napp.use(cors());\napp.use(express.json());\napp.use(express.urlencoded({ extended: true }));\n\n/** 健康检查 */\napp.get('/api/health', (_req, res) => {\n  res.json({\n    success: true,\n    message: 'ShopEase 商城服务运行中',\n    timestamp: new Date().toISOString(),\n    uptime: process.uptime(),\n  });\n});\n\n/** 路由注册 */\napp.use('/api/auth', authRoutes);\napp.use('/api/products', productRoutes);\napp.use('/api/cart', cartRoutes);\napp.use('/api/orders', orderRoutes);\n\n/** 404 处理 */\napp.use((_req, res) => {\n  res.status(404).json({\n    success: false,\n    message: '请求的资源不存在',\n  });\n});\n\n/** 全局错误处理 */\napp.use((err: Error, _req: express.Request, res: express.Response, _next: express.NextFunction) => {\n  console.error('服务器错误:', err);\n  res.status(500).json({\n    success: false,\n    message: config.isDev ? err.message : '服务器内部错误',\n  });\n});\n\n/** 启动服务器（非测试环境下）*/\nif (!config.isTest) {\n  initDB();\n  app.listen(config.port, () => {\n    console.log(`\\n🛒  ShopEase 商城服务已启动`);\n    console.log(`📡  API地址: http://localhost:${config.port}/api`);\n    console.log(`🏥 健康检查: http://localhost:${config.port}/api/health\\n`);\n  });\n}\n\nexport default app;","timestamp":1781396939,"tool_call_id":"call_87fe49bd5d8d40b4a26ac8fd","tool_name":"read_file","tool_calls":null}
{"type":"message","id":"0cf68cb7-3213-46cf-b956-fd47e1cdebda","role":"tool","content":"import { v4 as uuidv4 } from 'uuid';\n\nexport function generateId(): string {\n  return uuidv4();\n}\n\nexport function generateOrderNo(): string {\n  const now = new Date();\n  const dateStr =\n    now.getFullYear().toString() +\n    String(now.getMonth() + 1).padStart(2, '0') +\n    String(now.getDate()).padStart(2, '0') +\n    String(now.getHours()).padStart(2, '0') +\n    String(now.getMinutes()).padStart(2, '0') +\n    String(now.getSeconds()).padStart(2, '0');\n  const random = Math.floor(Math.random() * 1000000)\n    .toString()\n    .padStart(6, '0');\n  return `SE${dateStr}${random}`;\n}","timestamp":1781396939,"tool_call_id":"call_05dc2fa31b3e40fb94106802","tool_name":"read_file","tool_calls":null}
