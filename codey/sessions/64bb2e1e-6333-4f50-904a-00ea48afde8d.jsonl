{"type":"message","id":"21be9e19-a373-4aa2-a55e-d0d6bb2115c8","role":"assistant","content":"### 任务 1: 重写 cart.ts 路由\n\n`cart.ts` 目前还在使用 Mongoose 模型（`CartItem.find()`、`CartItem.findOne()` 等），需要全部替换为 SQLite 查询，并且购物车返回数据要带完整的商品信息。\n\n\n","timestamp":1781395947,"tool_call_id":null,"tool_name":null,"tool_calls":null}
{"type":"message","id":"8914ad85-16ff-4f37-bdff-66aa22c49744","role":"assistant","content":"","timestamp":1781395947,"tool_call_id":null,"tool_name":null,"tool_calls":[{"id":"call_97aaca8aac7f4d06909f456b","name":"write_file","arguments":"{\"path\": \"D:\\\\123\\\\server\\\\src\\\\routes\\\\cart.ts\", \"content\": \"import { Router, Request, Response } from 'express';\\nimport { body, validationResult } from 'express-validator';\\nimport { getDB } from '../config/database';\\nimport { authenticate } from '../middleware/auth';\\nimport { generateId } from '../utils/order';\\nimport { CartItemRow, ProductRow, ProductData, rowToProduct } from '../models';\\n\\nconst router = Router();\\n\\n/** 使用认证中间件 - 所有购物车接口都需要登录 */\\nrouter.use(authenticate);\\n\\n/** 统一校验处理 */\\nconst handleValidationErrors = (req: Request, res: Response): boolean => {\\n  const errors = validationResult(req);\\n  if (!errors.isEmpty()) {\\n    res.status(400).json({\\n      success: false,\\n      message: '参数校验失败',\\n      errors: errors.array().map((e) => e.msg),\\n    });\\n    return true;\\n  }\\n  return false;\\n};\\n\\n/** 将购物车行转换为前端格式 */\\nfunction rowToCartData(row: CartItemRow, product: ProductRow): any {\\n  return {\\n    _id: row.id,\\n    userId: row.user_id,\\n    productId: rowToProduct(product),\\n    quantity: row.quantity,\\n    createdAt: row.created_at,\\n    updatedAt: row.updated_at,\\n  };\\n}\\n\\n/**\\n * GET /api/cart - 获取购物车列表\\n */\\nrouter.get('/', (req: Request, res: Response) => {\\n  try {\\n    const db = getDB();\\n    const rows = db.prepare(\\n      'SELECT c.*, p.* FROM cart_items c JOIN products p ON c.product_id = p.id WHERE c.user_id = ? ORDER BY c.created_at DESC'\\n    ).all(req.userId) as any[];\\n\\n    const validItems = rows\\n      .filter(r => r.status === 'active')\\n      .map(r => {\\n        const cartRow: CartItemRow = {\\n          id: r.id,\\n          user_id: r.user_id,\\n          product_id: r.product_id,\\n          quantity: r.quantity,\\n          created_at: r.created_at,\\n          updated_at: r.updated_at,\\n        };\\n        const productRow: ProductRow = {\\n          id: r.id_product || r.product_id,\\n          name: r.name,\\n          description: r.description,\\n          price: r.price,\\n          original_price: r.original_price,\\n          images: r.images,\\n          category: r.category,\\n          stock: r.stock,\\n          sales: r.sales,\\n          rating: r.rating,\\n          status: r.status,\\n          created_at: r.p_created_at || r.created_at,\\n          updated_at: r.p_updated_at || r.updated_at,\\n        };\\n        return rowToCartData(cartRow, productRow);\\n      });\\n\\n    res.json({ success: true, data: validItems });\\n  } catch (error: any) {\\n    res.status(500).json({ success: false, message: '获取购物车失败', error: error.message });\\n  }\\n});\\n\\n/**\\n * POST /api/cart - 添加商品到购物车\\n */\\nrouter.post(\\n  '/',\\n  [\\n    body('productId').notEmpty().withMessage('商品ID不能为空'),\\n    body('quantity').isInt({ min: 1 }).withMessage('数量必须大于0'),\\n  ],\\n  (req: Request, res: Response) => {\\n    if (handleValidationErrors(req, res)) return;\\n\\n    try {\\n      const db = getDB();\\n      const { productId, quantity } = req.body;\\n\\n      // 验证商品存在且有效\\n      const product = db.prepare(\\n        \\\"SELECT * FROM products WHERE id = ? AND status = 'active'\\\"\\n      ).get(productId) as ProductRow | undefined;\\n\\n      if (!product) {\\n        res.status(404).json({ success: false, message: '商品不存在或已下架' });\\n        return;\\n      }\\n\\n      if (product.stock < quantity) {\\n        res.status(400).json({\\n          success: false,\\n          message: `商品库存不足，当前库存: ${product.stock}`,\\n        });\\n        return;\\n      }\\n\\n      // 检查是否已在购物车中\\n      const existingItem = db.prepare(\\n        'SELECT * FROM cart_items WHERE user_id = ? AND product_id = ?'\\n      ).get(req.userId, productId) as CartItemRow | undefined;\\n\\n      if (existingItem) {\\n        // 更新数量\\n        const newQuantity = existingItem.quantity + quantity;\\n        if (newQuantity > product.stock) {\\n          res.status(400).json({\\n            success: false,\\n            message: `购物车中该商品数量已达上限，最大可购买 ${product.stock} 件`,\\n          });\\n          return;\\n        }\\n\\n        db.prepare(\\n          \\\"UPDATE cart_items SET quantity = ?, updated_at = datetime('now') WHERE id = ?\\\"\\n        ).run(newQuantity, existingItem.id);\\n\\n        const updated = db.prepare(\\n          'SELECT * FROM cart_items WHERE id = ?'\\n        ).get(existingItem.id) as CartItemRow;\\n\\n        res.json({\\n          success: true,\\n          data: rowToCartData(updated, product),\\n          message: '购物车已更新',\\n        });\\n      } else {\\n        // 新建购物车项\\n        const id = generateId();\\n        db.prepare(\\n          'INSERT INTO cart_items (id, user_id, product_id, quantity) VALUES (?, ?, ?, ?)'\\n        ).run(id, req.userId, productId, quantity);\\n\\n        const newItem = db.prepare('SELECT * FROM cart_items WHERE id = ?').get(id) as CartItemRow;\\n\\n        res.status(201).json({\\n          success: true,\\n          data: rowToCartData(newItem, product),\\n          message: '已添加到购物车',\\n        });\\n      }\\n    } catch (error: any) {\\n      res.status(500).json({ success: false, message: '添加购物车失败', error: error.message });\\n    }\\n  }\\n);\\n\\n/**\\n * PUT /api/cart/:id - 修改购物车项数量\\n */\\nrouter.put(\\n  '/:id',\\n  [body('quantity').isInt({ min: 1 }).withMessage('数量必须大于0')],\\n  (req: Request, res: Response) => {\\n    if (handleValidationErrors(req, res)) return;\\n\\n    try {\\n      const db = getDB();\\n      const { quantity } = req.body;\\n\\n      const cartItem = db.prepare(\\n        'SELECT * FROM cart_items WHERE id = ? AND user_id = ?'\\n      ).get(req.params.id, req.userId) as CartItemRow | undefined;\\n\\n      if (!cartItem) {\\n        res.status(404).json({ success: false, message: '购物车项不存在' });\\n        return;\\n      }\\n\\n      // 验证库存\\n      const product = db.prepare('SELECT * FROM products WHERE id = ?').get(cartItem.product_id) as ProductRow | undefined;\\n      if (product && quantity > product.stock) {\\n        res.status(400).json({\\n          success: false,\\n          message: `库存不足，当前库存: ${product.stock}`,\\n        });\\n        return;\\n      }\\n\\n      db.prepare(\\n        \\\"UPDATE cart_items SET quantity = ?, updated_at = datetime('now') WHERE id = ?\\\"\\n      ).run(quantity, req.params.id);\\n\\n      const updated = db.prepare('SELECT * FROM cart_items WHERE id = ?').get(req.params.id) as CartItemRow;\\n      const prod = db.prepare('SELECT * FROM products WHERE id = ?').get(cartItem.product_id) as ProductRow;\\n\\n      res.json({ success: true, data: rowToCartData(updated, prod) });\\n    } catch (error: any) {\\n      res.status(500).json({ success: false, message: '更新购物车失败' });\\n    }\\n  }\\n);\\n\\n/**\\n * DELETE /api/cart/:id - 删除购物车项\\n */\\nrouter.delete('/:id', (req: Request, res: Response) => {\\n  try {\\n    const db = getDB();\\n    const cartItem = db.prepare(\\n      'SELECT * FROM cart_items WHERE id = ? AND user_id = ?'\\n    ).get(req.params.id, req.userId);\\n\\n    if (!cartItem) {\\n      res.status(404).json({ success: false, message: '购物车项不存在' });\\n      return;\\n    }\\n\\n    db.prepare('DELETE FROM cart_items WHERE id = ?').run(req.params.id);\\n\\n    res.json({ success: true, message: '已从购物车移除' });\\n  } catch (error: any) {\\n    res.status(500).json({ success: false, message: '删除购物车项失败' });\\n  }\\n});\\n\\n/**\\n * DELETE /api/cart - 清空购物车\\n */\\nrouter.delete('/', (req: Request, res: Response) => {\\n  try {\\n    const db = getDB();\\n    db.prepare('DELETE FROM cart_items WHERE user_id = ?').run(req.userId);\\n    res.json({ success: true, message: '购物车已清空' });\\n  } catch (error: any) {\\n    res.status(500).json({ success: false, message: '清空购物车失败' });\\n  }\\n});\\n\\nexport default router;\"}"}]}
