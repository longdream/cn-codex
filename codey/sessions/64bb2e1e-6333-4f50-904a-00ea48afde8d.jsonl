{"type":"message","id":"d3367205-15f3-4545-ae39-a73f9229424d","role":"tool","content":"import { useEffect } from 'react';\nimport { Routes, Route, Navigate } from 'react-router-dom';\nimport { useAuthStore } from './store/authStore';\n\n// 页面组件\nimport HomePage from './pages/HomePage';\nimport ProductListPage from './pages/ProductListPage';\nimport ProductDetailPage from './pages/ProductDetailPage';\nimport LoginPage from './pages/LoginPage';\nimport RegisterPage from './pages/RegisterPage';\nimport CartPage from './pages/CartPage';\nimport OrderListPage from './pages/OrderListPage';\nimport OrderDetailPage from './pages/OrderDetailPage';\nimport AdminPage from './pages/AdminPage';\nimport ProfilePage from './pages/ProfilePage';\n\n// 组件\nimport AppLayout from './components/AppLayout';\nimport AuthGuard from './components/AuthGuard';\nimport AdminGuard from './components/AdminGuard';\n\nfunction App() {\n  const init = useAuthStore((state) => state.init);\n\n  useEffect(() => {\n    init();\n  }, [init]);\n\n  return (\n    <Routes>\n      {/* 公开页面 */}\n      <Route element={<AppLayout />}>\n        <Route path=\"/\" element={<HomePage />} />\n        <Route path=\"/products\" element={<ProductListPage />} />\n        <Route path=\"/products/:id\" element={<ProductDetailPage />} />\n        <Route path=\"/login\" element={<LoginPage />} />\n        <Route path=\"/register\" element={<RegisterPage />} />\n\n        {/* 需要登录的页面 */}\n        <Route\n          path=\"/cart\"\n          element={\n            <AuthGuard>\n              <CartPage />\n            </AuthGuard>\n          }\n        />\n        <Route\n          path=\"/orders\"\n          element={\n            <AuthGuard>\n              <OrderListPage />\n            </AuthGuard>\n          }\n        />\n        <Route\n          path=\"/orders/:id\"\n          element={\n            <AuthGuard>\n              <OrderDetailPage />\n            </AuthGuard>\n          }\n        />\n        <Route\n          path=\"/profile\"\n          element={\n            <AuthGuard>\n              <ProfilePage />\n            </AuthGuard>\n          }\n        />\n\n        {/* 管理员页面 */}\n        <Route\n          path=\"/admin/*\"\n          element={\n            <AdminGuard>\n              <AdminPage />\n            </AdminGuard>\n          }\n        />\n\n        {/* 404 重定向到首页 */}\n        <Route path=\"*\" element={<Navigate to=\"/\" replace />} />\n      </Route>\n    </Routes>\n  );\n}\n\nexport default App;","timestamp":1781395921,"tool_call_id":"call_7f9c5edb36504608961f491b","tool_name":"read_file","tool_calls":null}
