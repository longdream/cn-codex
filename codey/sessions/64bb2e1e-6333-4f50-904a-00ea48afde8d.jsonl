{"type":"message","id":"44a64156-cad6-47a8-83e7-9a7146ef4746","role":"tool","content":"import Database from 'better-sqlite3';\nimport path from 'path';\nimport { config } from './index';\n\nlet db: Database.Database;\n\nexport function getDB(): Database.Database {\n  if (!db) {\n    const dbPath = config.isTest ? ':memory:' : path.resolve(__dirname, '../../', config.databasePath);\n    db = new Database(dbPath);\n    db.pragma('journal_mode = WAL');\n    db.pragma('foreign_keys = ON');\n    if (!config.isTest) {\n      console.log(`SQLite 数据库已连接: ${dbPath === ':memory:' ? '内存模式' : dbPath}`);\n    }\n  }\n  return db;\n}\n\nexport function initDB(): void {\n  const db = getDB();\n\n  db.exec(`\n    CREATE TABLE IF NOT EXISTS users (\n      id TEXT PRIMARY KEY,\n      email TEXT NOT NULL UNIQUE,\n      password TEXT NOT NULL,\n      nickname TEXT NOT NULL,\n      avatar TEXT DEFAULT '',\n      role TEXT DEFAULT 'user' CHECK(role IN ('user','admin')),\n      is_active INTEGER DEFAULT 1,\n      created_at TEXT DEFAULT (datetime('now')),\n      updated_at TEXT DEFAULT (datetime('now'))\n    );\n\n    CREATE TABLE IF NOT EXISTS addresses (\n      id TEXT PRIMARY KEY,\n      user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n      name TEXT NOT NULL,\n      phone TEXT NOT NULL,\n      province TEXT DEFAULT '',\n      city TEXT DEFAULT '',\n      district TEXT DEFAULT '',\n      detail TEXT NOT NULL,\n      is_default INTEGER DEFAULT 0,\n      created_at TEXT DEFAULT (datetime('now'))\n    );\n\n    CREATE TABLE IF NOT EXISTS products (\n      id TEXT PRIMARY KEY,\n      name TEXT NOT NULL,\n      description TEXT NOT NULL,\n      price REAL NOT NULL,\n      original_price REAL DEFAULT 0,\n      images TEXT DEFAULT '[]',\n      category TEXT NOT NULL,\n      stock INTEGER DEFAULT 0,\n      sales INTEGER DEFAULT 0,\n      rating REAL DEFAULT 5.0,\n      status TEXT DEFAULT 'active' CHECK(status IN ('active','inactive')),\n      created_at TEXT DEFAULT (datetime('now')),\n      updated_at TEXT DEFAULT (datetime('now'))\n    );\n\n    CREATE TABLE IF NOT EXISTS cart_items (\n      id TEXT PRIMARY KEY,\n      user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n      product_id TEXT NOT NULL REFERENCES products(id) ON DELETE CASCADE,\n      quantity INTEGER DEFAULT 1,\n      created_at TEXT DEFAULT (datetime('now')),\n      updated_at TEXT DEFAULT (datetime('now')),\n      UNIQUE(user_id, product_id)\n    );\n\n    CREATE TABLE IF NOT EXISTS orders (\n      id TEXT PRIMARY KEY,\n      order_no TEXT NOT NULL UNIQUE,\n      user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n      total_amount REAL NOT NULL,\n      status TEXT DEFAULT 'pending' CHECK(status IN ('pending','paid','shipped','delivered','cancelled')),\n      shipping_name TEXT NOT NULL,\n      shipping_phone TEXT NOT NULL,\n      shipping_detail TEXT NOT NULL,\n      paid_at TEXT,\n      created_at TEXT DEFAULT (datetime('now')),\n      updated_at TEXT DEFAULT (datetime('now'))\n    );\n\n    CREATE TABLE IF NOT EXISTS order_items (\n      id TEXT PRIMARY KEY,\n      order_id TEXT NOT NULL REFERENCES orders(id) ON DELETE CASCADE,\n      product_id TEXT NOT NULL,\n      product_name TEXT NOT NULL,\n      price REAL NOT NULL,\n      quantity INTEGER NOT NULL,\n      image TEXT DEFAULT '',\n      created_at TEXT DEFAULT (datetime('now'))\n    );\n\n    CREATE INDEX IF NOT EXISTS idx_users_email ON users(email);\n    CREATE INDEX IF NOT EXISTS idx_products_category ON products(category);\n    CREATE INDEX IF NOT EXISTS idx_products_status ON products(status);\n    CREATE INDEX IF NOT EXISTS idx_cart_user ON cart_items(user_id);\n    CREATE INDEX IF NOT EXISTS idx_orders_user ON orders(user_id);\n    CREATE INDEX IF NOT EXISTS idx_orders_status ON orders(status);\n    CREATE INDEX IF NOT EXISTS idx_order_items_order ON order_items(order_id);\n  `);\n\n  if (!config.isTest) {\n    console.log('数据库表结构初始化完成');\n  }\n}\n\nexport function closeDB(): void {\n  if (db) {\n    db.close();\n  }\n}\n\nexport function clearDB(): void {\n  const db = getDB();\n  const tables = ['order_items', 'orders', 'cart_items', 'products', 'addresses', 'users'];\n  for (const table of tables) {\n    db.exec(`DELETE FROM ${table}`);\n  }\n}","timestamp":1781396184,"tool_call_id":"call_b12c8a3a4287461ab376a111","tool_name":"read_file","tool_calls":null}
{"type":"message","id":"c92226ae-d0e6-4ac0-8c5b-d0f72205f033","role":"assistant","content":"问题是 `:memory:` 数据库在测试环境中需要在 `beforeEach` 中重建才能做到隔离。但现有的 `initDB()` 使用了 `CREATE TABLE IF NOT EXISTS`，所以同一个 `:memory:` 连接中多次调用没问题。但是多个测试文件中共享同一个 `:memory:` 数据库会导致数据污染。\n\n更好的方法：让每个测试文件在 `jest.config.js` 中设置 `setupFilesAfterFramework` 来确保隔离。但最简单的方式是在 `config/database.ts` 中加入重置数据库的机制——每次 `initDB()` 调用时都重新创建表。\n\n等等，实际上 `:memory:` 数据库的生命周期与连接绑定。只要 jest 在跑多个测试文件时用的是同一个进程，`getDB()` 返回的就是同一个数据库实例。\n\n让我修改数据库模块，使得测试环境中每次 `clearDB()` 都能正常清理：\n\n\n\n\n","timestamp":1781396195,"tool_call_id":null,"tool_name":null,"tool_calls":null}
{"type":"message","id":"c50f4ca4-be1b-46ee-873b-39f3eab1a4c2","role":"assistant","content":"","timestamp":1781396195,"tool_call_id":null,"tool_name":null,"tool_calls":[{"id":"call_81faa2e5c70b46adb829f493","name":"write_file","arguments":"{\"path\": \"D:\\\\123\\\\server\\\\src\\\\config\\\\database.ts\", \"content\": \"import Database from 'better-sqlite3';\\nimport path from 'path';\\nimport { config } from './index';\\n\\nlet db: Database.Database | null = null;\\n\\nexport function getDB(): Database.Database {\\n  if (!db) {\\n    const dbPath = config.isTest ? ':memory:' : path.resolve(__dirname, '../../', config.databasePath);\\n    db = new Database(dbPath);\\n    db.pragma('journal_mode = WAL');\\n    db.pragma('foreign_keys = ON');\\n    if (!config.isTest) {\\n      console.log(`SQLite 数据库已连接: ${dbPath === ':memory:' ? '内存模式' : dbPath}`);\\n    }\\n  }\\n  return db;\\n}\\n\\nexport function initDB(): void {\\n  const database = getDB();\\n\\n  database.exec(`\\n    CREATE TABLE IF NOT EXISTS users (\\n      id TEXT PRIMARY KEY,\\n      email TEXT NOT NULL UNIQUE,\\n      password TEXT NOT NULL,\\n      nickname TEXT NOT NULL,\\n      avatar TEXT DEFAULT '',\\n      role TEXT DEFAULT 'user' CHECK(role IN ('user','admin')),\\n      is_active INTEGER DEFAULT 1,\\n      created_at TEXT DEFAULT (datetime('now')),\\n      updated_at TEXT DEFAULT (datetime('now'))\\n    );\\n\\n    CREATE TABLE IF NOT EXISTS addresses (\\n      id TEXT PRIMARY KEY,\\n      user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,\\n      name TEXT NOT NULL,\\n      phone TEXT NOT NULL,\\n      province TEXT DEFAULT '',\\n      city TEXT DEFAULT '',\\n      district TEXT DEFAULT '',\\n      detail TEXT NOT NULL,\\n      is_default INTEGER DEFAULT 0,\\n      created_at TEXT DEFAULT (datetime('now'))\\n    );\\n\\n    CREATE TABLE IF NOT EXISTS products (\\n      id TEXT PRIMARY KEY,\\n      name TEXT NOT NULL,\\n      description TEXT NOT NULL,\\n      price REAL NOT NULL,\\n      original_price REAL DEFAULT 0,\\n      images TEXT DEFAULT '[]',\\n      category TEXT NOT NULL,\\n      stock INTEGER DEFAULT 0,\\n      sales INTEGER DEFAULT 0,\\n      rating REAL DEFAULT 5.0,\\n      status TEXT DEFAULT 'active' CHECK(status IN ('active','inactive')),\\n      created_at TEXT DEFAULT (datetime('now')),\\n      updated_at TEXT DEFAULT (datetime('now'))\\n    );\\n\\n    CREATE TABLE IF NOT EXISTS cart_items (\\n      id TEXT PRIMARY KEY,\\n      user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,\\n      product_id TEXT NOT NULL REFERENCES products(id) ON DELETE CASCADE,\\n      quantity INTEGER DEFAULT 1,\\n      created_at TEXT DEFAULT (datetime('now')),\\n      updated_at TEXT DEFAULT (datetime('now')),\\n      UNIQUE(user_id, product_id)\\n    );\\n\\n    CREATE TABLE IF NOT EXISTS orders (\\n      id TEXT PRIMARY KEY,\\n      order_no TEXT NOT NULL UNIQUE,\\n      user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,\\n      total_amount REAL NOT NULL,\\n      status TEXT DEFAULT 'pending' CHECK(status IN ('pending','paid','shipped','delivered','cancelled')),\\n      shipping_name TEXT NOT NULL,\\n      shipping_phone TEXT NOT NULL,\\n      shipping_detail TEXT NOT NULL,\\n      paid_at TEXT,\\n      created_at TEXT DEFAULT (datetime('now')),\\n      updated_at TEXT DEFAULT (datetime('now'))\\n    );\\n\\n    CREATE TABLE IF NOT EXISTS order_items (\\n      id TEXT PRIMARY KEY,\\n      order_id TEXT NOT NULL REFERENCES orders(id) ON DELETE CASCADE,\\n      product_id TEXT NOT NULL,\\n      product_name TEXT NOT NULL,\\n      price REAL NOT NULL,\\n      quantity INTEGER NOT NULL,\\n      image TEXT DEFAULT '',\\n      created_at TEXT DEFAULT (datetime('now'))\\n    );\\n\\n    CREATE INDEX IF NOT EXISTS idx_users_email ON users(email);\\n    CREATE INDEX IF NOT EXISTS idx_products_category ON products(category);\\n    CREATE INDEX IF NOT EXISTS idx_products_status ON products(status);\\n    CREATE INDEX IF NOT EXISTS idx_cart_user ON cart_items(user_id);\\n    CREATE INDEX IF NOT EXISTS idx_orders_user ON orders(user_id);\\n    CREATE INDEX IF NOT EXISTS idx_orders_status ON orders(status);\\n    CREATE INDEX IF NOT EXISTS idx_order_items_order ON order_items(order_id);\\n  `);\\n\\n  if (!config.isTest) {\\n    console.log('数据库表结构初始化完成');\\n  }\\n}\\n\\nexport function closeDB(): void {\\n  if (db) {\\n    db.close();\\n    db = null;\\n  }\\n}\\n\\nexport function clearDB(): void {\\n  const database = getDB();\\n  // 先禁用外键检查，然后清空所有表\\n  database.exec('PRAGMA foreign_keys = OFF');\\n  const tables = ['order_items', 'orders', 'cart_items', 'products', 'addresses', 'users'];\\n  for (const table of tables) {\\n    database.exec(`DELETE FROM \\\"${table}\\\"`);\\n  }\\n  database.exec('PRAGMA foreign_keys = ON');\\n}\"}"}]}
